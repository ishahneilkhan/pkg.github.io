rules_version = '2';

// Website Deals - Firestore rules.
// Anyone can READ the published site data (it is shown on the public site).
// Only the signed-in admin(s) listed below can WRITE it.
// Admin email is set below. Paste this file into
// Firebase Console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["thesnkgraphic@email.com"];
    }

    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Images added in Admin -> Site Editor. Public read, admin-only write.
    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Checkout orders: the public can only CREATE a new order (fixed fields,
    // status "new"). Only the admin can read, update or delete them.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(["order","pkg","price","name","phone","email","biz","method","tx","from","status","createdAt"])
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() < 120
        && request.resource.data.phone is string && request.resource.data.phone.size() < 40
        && request.resource.data.price is number;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
