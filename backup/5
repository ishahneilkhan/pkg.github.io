  <script>

    /* =========================
       WEBSITE DATA
    ========================= */

    const defaultWebsites = [

      {
        id: "snk-it-institute",
        name: "SNK IT Institute",
        package: "business",
        packageLabel: "Business Package",
        url: "https://snkitinstitute.com",
        animation: "zoom",
        status: true,
        sort: 1
      },

      {
        id: "website-deals-demo",
        name: "Website Deals",
        package: "premium",
        packageLabel: "Premium Package",
        url: "https://websitedeals.com",
        animation: "float",
        status: true,
        sort: 2
      }

    ];


    let websites = [];

    try {

      const saved =
        JSON.parse(
          localStorage.getItem("websiteDealsWebsites")
        );

      websites =
        Array.isArray(saved) && saved.length
          ? saved
          : defaultWebsites;

    } catch {

      websites = defaultWebsites;

    }


    /* =========================
       WEBSITE RENDER
    ========================= */

    const websiteTrack =
      document.getElementById("websiteTrack");


    function renderWebsites(filter = "all") {

      websiteTrack.innerHTML = "";

      const filtered =
        websites
          .filter(site => site.status !== false)
          .filter(site => {
            if (filter === "all") return true;
            return site.package === filter;
          })
          .sort((a,b) =>
            (a.sort || 0) - (b.sort || 0)
          );


      if (!filtered.length) {

        websiteTrack.innerHTML = `
          <div style="
            width:100%;
            padding:50px;
            border:1px solid var(--line);
            border-radius:20px;
            text-align:center;
            color:var(--muted);
          ">
            No websites available in this package.
          </div>
        `;

        return;

      }


      filtered.forEach((site, index) => {

        const card =
          document.createElement("article");

        card.className = "website-card";

        card.innerHTML = `

          <div class="website-preview">

            <iframe
              class="preview-screen"
              src="${escapeAttribute(site.url)}"
              title="${escapeAttribute(site.name)}"
              loading="lazy"
            ></iframe>

            <div class="preview-fallback">
              <strong>${escapeHTML(site.name)}</strong>
              <span>Live website preview</span>
            </div>

          </div>


          <div class="website-info">

            <div class="website-meta">

              <span>
                ${escapeHTML(site.packageLabel || site.package)}
              </span>

              <span class="live-status">
                LIVE
              </span>

            </div>


            <h3>
              ${escapeHTML(site.name)}
            </h3>


            <div class="website-url">
              ${escapeHTML(site.url)}
            </div>


            <div class="website-actions">

              <button
                class="btn btn-secondary"
                onclick="openPresentation(${index}, '${filter}')"
              >
                Explore
              </button>

              <a
                class="btn btn-primary"
                href="${escapeAttribute(site.url)}"
                target="_blank"
                rel="noopener"
              >
                Open Live
              </a>

            </div>

          </div>
        `;

        websiteTrack.appendChild(card);

      });

    }


    function escapeHTML(value) {

      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }


    function escapeAttribute(value) {

      return escapeHTML(value);

    }


    renderWebsites();


    /* =========================
       FILTERS
    ========================= */

    document
      .querySelectorAll(".filter-btn")
      .forEach(button => {

        button.addEventListener("click", () => {

          document
            .querySelectorAll(".filter-btn")
            .forEach(btn =>
              btn.classList.remove("active")
            );

          button.classList.add("active");

          renderWebsites(
            button.dataset.filter
          );

        });

      });


    /* =========================
       HORIZONTAL AUTO SCROLL
    ========================= */

    let autoScroll = true;

    let scrollDirection = 1;

    let scrollPaused = false;


    function autoHorizontalScroll() {

      if (
        !autoScroll ||
        scrollPaused ||
        document
          .getElementById("presentation")
          .classList.contains("open")
      ) {
        return;
      }


      const maxScroll =
        websiteTrack.scrollWidth -
        websiteTrack.clientWidth;


      if (maxScroll <= 0) return;


      websiteTrack.scrollLeft +=
        .45 * scrollDirection;


      if (
        websiteTrack.scrollLeft >=
        maxScroll - 2
      ) {

        scrollDirection = -1;

      }


      if (
        websiteTrack.scrollLeft <= 2
      ) {

        scrollDirection = 1;

      }

    }


    setInterval(
      autoHorizontalScroll,
      25
    );


    websiteTrack.addEventListener(
      "mouseenter",
      () => scrollPaused = true
    );

    websiteTrack.addEventListener(
      "mouseleave",
      () => scrollPaused = false
    );

    websiteTrack.addEventListener(
      "touchstart",
      () => scrollPaused = true,
      { passive: true }
    );

    websiteTrack.addEventListener(
      "touchend",
      () => {
        setTimeout(
          () => scrollPaused = false,
          1200
        );
      },
      { passive: true }
    );


    function scrollWebsites(direction) {

      websiteTrack.scrollBy({
        left: direction * 370,
        behavior: "smooth"
      });

    }


    /* =========================
       PRESENTATION
    ========================= */

    const presentation =
      document.getElementById("presentation");

    const presentationFrame =
      document.getElementById("presentationFrame");

    const presentationName =
      document.getElementById("presentationName");

    const presentationPackage =
      document.getElementById("presentationPackage");

    const device =
      document.getElementById("device");

    const progressBar =
      document.getElementById("progressBar");

    let presentationList = [];

    let presentationIndex = 0;

    let autoPlay = false;

    let presentationTimer = null;

    let progressTimer = null;


    function getPresentationList(filter) {

      return websites
        .filter(site => site.status !== false)
        .filter(site => {

          if (filter === "all") return true;

          return site.package === filter;

        })
        .sort((a,b) =>
          (a.sort || 0) - (b.sort || 0)
        );

    }


    function openPresentation(
      index,
      filter = "all"
    ) {

      presentationList =
        getPresentationList(filter);

      if (!presentationList.length) return;

      presentationIndex =
        Math.max(
          0,
          Math.min(
            index,
            presentationList.length - 1
          )
        );

      presentation.classList.add("open");

      document.body.style.overflow = "hidden";

      loadPresentation();

    }


    function loadPresentation() {

      const site =
        presentationList[presentationIndex];

      if (!site) return;


      presentationName.textContent =
        site.name;

      presentationPackage.textContent =
        `${site.packageLabel || "Website"} • Live Presentation`;


      presentationFrame.src =
        site.url;


      device.classList.remove("slide");

      void device.offsetWidth;

      device.classList.add("slide");


      progressBar.style.width = "0%";


      if (autoPlay) {

        startPresentationProgress();

      }

    }


    function nextPresentation() {

      if (!presentationList.length) return;

      presentationIndex =
        (presentationIndex + 1) %
        presentationList.length;

      loadPresentation();

    }


    function previousPresentation() {

      if (!presentationList.length) return;

      presentationIndex =
        (presentationIndex - 1 +
        presentationList.length) %
        presentationList.length;

      loadPresentation();

    }


    document
      .getElementById("nextPresentation")
      .addEventListener(
        "click",
        nextPresentation
      );


    document
      .getElementById("prevPresentation")
      .addEventListener(
        "click",
        previousPresentation
      );


    document
      .getElementById("closePresentation")
      .addEventListener(
        "click",
        closePresentation
      );


    function closePresentation() {

      presentation.classList.remove("open");

      document.body.style.overflow = "";

      stopPresentationProgress();

      presentationFrame.src = "about:blank";

    }


    /* =========================
       AUTOPLAY
    ========================= */

    function startPresentationProgress() {

      stopPresentationProgress();

      let start = Date.now();

      const duration = 8000;

      progressTimer =
        setInterval(() => {

          const elapsed =
            Date.now() - start;

          const percent =
            Math.min(
              100,
              (elapsed / duration) * 100
            );

          progressBar.style.width =
            percent + "%";


          if (percent >= 100) {

            nextPresentation();

            start = Date.now();

          }

        }, 80);

    }


    function stopPresentationProgress() {

      clearInterval(progressTimer);

      progressTimer = null;

      progressBar.style.width = "0%";

    }


    document
      .getElementById("autoBtn")
      .addEventListener(
        "click",
        () => {

          autoPlay = !autoPlay;

          document
            .getElementById("autoBtn")
            .textContent =
              autoPlay ? "❚❚" : "▶";


          if (autoPlay) {

            startPresentationProgress();

            showToast(
              "Auto presentation ON"
            );

          } else {

            stopPresentationProgress();

            showToast(
              "Auto presentation OFF"
            );

          }

        }
      );


    /* =========================
       FULLSCREEN
    ========================= */

    document
      .getElementById("fullscreenBtn")
      .addEventListener(
        "click",
        async () => {

          try {

            if (!document.fullscreenElement) {

              await presentation.requestFullscreen();

            } else {

              await document.exitFullscreen();

            }

          } catch {

            showToast(
              "Fullscreen is not available."
            );

          }

        }
      );


    /* =========================
       OPEN LIVE
    ========================= */

    document
      .getElementById("openLiveBtn")
      .addEventListener(
        "click",
        () => {

          const site =
            presentationList[presentationIndex];

          if (!site) return;

          window.open(
            site.url,
            "_blank",
            "noopener"
          );

        }
      );


    /* =========================
       SOUND
    ========================= */

    let soundOn = false;

    let audioContext = null;


    function playSoftSound() {

      if (!soundOn) return;

      try {

        if (!audioContext) {

          audioContext =
            new (
              window.AudioContext ||
              window.webkitAudioContext
            )();

        }


        const oscillator =
          audioContext.createOscillator();

        const gain =
          audioContext.createGain();


        oscillator.frequency.value = 520;

        gain.gain.value = .025;

        oscillator.connect(gain);

        gain.connect(
          audioContext.destination
        );


        oscillator.start();

        oscillator.stop(
          audioContext.currentTime + .06
        );

      } catch {}

    }


    document
      .getElementById("soundBtn")
      .addEventListener(
        "click",
        () => {

          soundOn = !soundOn;

          document
            .getElementById("soundBtn")
            .textContent =
              soundOn ? "🔊" : "🔇";

          if (soundOn) {

            playSoftSound();

            showToast(
              "Presentation sound ON"
            );

          } else {

            showToast(
              "Presentation sound OFF"
            );

          }

        }
      );


    /* =========================
       KEYBOARD
    ========================= */

    document.addEventListener(
      "keydown",
      event => {

        if (
          !presentation.classList.contains("open")
        ) {
          return;
        }


        if (event.key === "Escape") {

          closePresentation();

        }

        else if (event.key === "ArrowRight") {

          nextPresentation();

          playSoftSound();

        }

        else if (event.key === "ArrowLeft") {

          previousPresentation();

          playSoftSound();

        }

        else if (
          event.key.toLowerCase() === "f"
        ) {

          document
            .getElementById("fullscreenBtn")
            .click();

        }

        else if (
          event.key.toLowerCase() === "s"
        ) {

          document
            .getElementById("soundBtn")
            .click();

        }

        else if (event.code === "Space") {

          event.preventDefault();

          document
            .getElementById("autoBtn")
            .click();

        }

      }
    );


    /* =========================
       TOUCH SWIPE
    ========================= */

    let touchStartX = 0;


    presentation
      .addEventListener(
        "touchstart",
        event => {

          touchStartX =
            event.touches[0].clientX;

        },
        { passive: true }
      );


    presentation
      .addEventListener(
        "touchend",
        event => {

          const endX =
            event.changedTouches[0].clientX;

          const distance =
            endX - touchStartX;


          if (Math.abs(distance) < 50) {
            return;
          }


          if (distance < 0) {

            nextPresentation();

          } else {

            previousPresentation();

          }

        },
        { passive: true }
      );


    /* =========================
       PACKAGE DETAILS
    ========================= */

    function showPackage(packageName) {

      const details = {

        Starter:
          "Starter — ৳549/month. Ready-made website, hosting, SSL, Firebase integration, responsive design, domain connection, contact form, basic SEO and support.",

        Business:
          "Business — ৳999/month. Everything in Starter plus premium website, admin panel, advanced Firebase, gateway, product/service management, inquiry/order management, analytics, SEO, backup, security and priority support.",

        Premium:
          "Premium — ৳1,999/month. Shopify-style e-commerce/business system with advanced admin dashboard, products, inventory, variants, coupons, cart, wishlist, checkout, payments, orders, analytics, automation and custom features."

      };


      showToast(
        details[packageName]
      );

    }


    /* =========================
       THEME
    ========================= */

    const savedTheme =
      localStorage.getItem(
        "websiteDealsTheme"
      );


    if (savedTheme === "light") {

      document.body.classList.add("light");

      document
        .getElementById("themeBtn")
        .textContent = "☾";

    }


    document
      .getElementById("themeBtn")
      .addEventListener(
        "click",
        () => {

          document.body.classList.toggle("light");

          const light =
            document.body.classList.contains("light");


          localStorage.setItem(
            "websiteDealsTheme",
            light ? "light" : "dark"
          );


          document
            .getElementById("themeBtn")
            .textContent =
              light ? "☾" : "☼";

        }
      );


    /* =========================
       PIN MODE
    ========================= */

    const pinned =
      localStorage.getItem(
        "websiteDealsPinned"
      ) === "true";


    if (pinned) {

      document.body.classList.add("pinned");

      document
        .getElementById("pinBtn")
        .textContent = "📍";

    }


    document
      .getElementById("pinBtn")
      .addEventListener(
        "click",
        () => {

          const isPinned =
            document.body.classList.toggle(
              "pinned"
            );


          localStorage.setItem(
            "websiteDealsPinned",
            isPinned
          );


          document
            .getElementById("pinBtn")
            .textContent =
              isPinned ? "📍" : "📌";


          showToast(
            isPinned
              ? "Marketing Wall mode ON"
              : "Marketing Wall mode OFF"
          );

        }
      );


    /* =========================
       MOBILE MENU
    ========================= */

    document
      .getElementById("mobileBtn")
      .addEventListener(
        "click",
        () => {

          document
            .getElementById("navLinks")
            .classList.toggle("open");

        }
      );


    document
      .querySelectorAll(".nav-links a")
      .forEach(link => {

        link.addEventListener(
          "click",
          () => {

            document
              .getElementById("navLinks")
              .classList.remove("open");

          }
        );

      });


    /* =========================
       ACTIVE NAV
    ========================= */

    const sections =
      document.querySelectorAll("section");

    const navItems =
      document.querySelectorAll(
        ".nav-links a"
      );


    const observer =
      new IntersectionObserver(
        entries => {

          entries.forEach(entry => {

            if (!entry.isIntersecting) {
              return;
            }


            navItems.forEach(link => {

              link.classList.remove(
                "active"
              );


              if (
                link.getAttribute("href") ===
                "#" + entry.target.id
              ) {

                link.classList.add(
                  "active"
                );

              }

            });

          });

        },
        {
          rootMargin:
            "-35% 0px -55% 0px"
        }
      );


    sections.forEach(
      section =>
        observer.observe(section)
    );


    /* =========================
       TOAST
    ========================= */

    let toastTimer;


    function showToast(message) {

      const toast =
        document.getElementById("toast");

      toast.textContent = message;

      toast.classList.add("show");


      clearTimeout(toastTimer);


      toastTimer =
        setTimeout(
          () =>
            toast.classList.remove("show"),
          3500
        );

    }


    /* =========================
       YEAR
    ========================= */

    document
      .getElementById("year")
      .textContent =
        new Date().getFullYear();


    /* =========================
       PWA
    ========================= */

    if ("serviceWorker" in navigator) {

      window.addEventListener(
        "load",
        () => {

          navigator.serviceWorker
            .register("/sw.js")
            .catch(() => {});

        }
      );

    }

  </script>

</body>
</html>
