<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="theme-color"
    content="#080909"
  >

  <meta
    name="description"
    content="Website Deals — Premium ready-made websites, packages and live website showcase."
  >

  <title>Website Deals | Live Digital Marketplace</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --bg: #080909;
      --bg-soft: #0d0f10;
      --card: rgba(20, 23, 24, .82);
      --card-2: #111415;
      --text: #f5f7f6;
      --muted: #929b98;
      --line: rgba(255,255,255,.09);
      --lime: #b7ff00;
      --lime-soft: rgba(183,255,0,.11);
      --white: #ffffff;
      --danger: #ff5d5d;
      --shadow: 0 25px 70px rgba(0,0,0,.38);
      --radius: 28px;
    }

    body.light {
      --bg: #f4f6f5;
      --bg-soft: #ffffff;
      --card: rgba(255,255,255,.88);
      --card-2: #ffffff;
      --text: #101514;
      --muted: #64706c;
      --line: rgba(16,21,20,.10);
      --lime-soft: rgba(116,170,0,.12);
      --shadow: 0 25px 60px rgba(30,40,35,.12);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 15% 5%, rgba(183,255,0,.08), transparent 28%),
        radial-gradient(circle at 90% 20%, rgba(183,255,0,.05), transparent 24%),
        var(--bg);
      color: var(--text);
      font-family: "Inter", "Hind Siliguri", sans-serif;
      overflow-x: hidden;
      transition: background .3s ease, color .3s ease;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: .035;
      background-image:
        linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
      background-size: 70px 70px;
      mask-image: linear-gradient(to bottom, black, transparent 80%);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .container {
      width: min(1180px, calc(100% - 36px));
      margin: auto;
    }

    /* =========================
       NAVBAR
    ========================= */

    .navbar {
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      background: rgba(8,9,9,.74);
      border-bottom: 1px solid var(--line);
    }

    body.light .navbar {
      background: rgba(244,246,245,.78);
    }

    .nav-inner {
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      flex-shrink: 0;
    }

    .brand-mark {
      width: 39px;
      height: 39px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      background: var(--lime);
      color: #080909;
      font-family: "Space Grotesk", sans-serif;
      font-weight: 800;
      letter-spacing: -1px;
      box-shadow: 0 0 35px rgba(183,255,0,.18);
    }

    .brand-text {
      font-family: "Space Grotesk", sans-serif;
      font-weight: 700;
      letter-spacing: -.5px;
    }

    .brand-text small {
      display: block;
      font-family: "Inter", sans-serif;
      font-size: 9px;
      color: var(--muted);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-top: 2px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-links a {
      padding: 10px 13px;
      border-radius: 12px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
      transition: .2s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--text);
      background: var(--lime-soft);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--text);
      border-radius: 12px;
      display: grid;
      place-items: center;
      transition: .2s ease;
    }

    .icon-btn:hover {
      border-color: rgba(183,255,0,.35);
      transform: translateY(-1px);
    }

    .mobile-toggle {
      display: none;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: calc(100vh - 76px);
      display: flex;
      align-items: center;
      position: relative;
      padding: 80px 0 90px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 65px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(183,255,0,.20);
      background: var(--lime-soft);
      border-radius: 999px;
      color: var(--lime);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      background: var(--lime);
      border-radius: 50%;
      box-shadow: 0 0 12px var(--lime);
      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      0%,100% { opacity: 1; transform: scale(1); }
      50% { opacity: .45; transform: scale(.72); }
    }

    .hero h1 {
      margin-top: 23px;
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(48px, 7vw, 88px);
      line-height: .95;
      letter-spacing: -5px;
      max-width: 750px;
    }

    .hero h1 span {
      color: var(--lime);
    }

    .hero-copy {
      margin-top: 24px;
      max-width: 620px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.8;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
      margin-top: 31px;
    }

    .btn {
      border: 0;
      min-height: 48px;
      padding: 0 19px;
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      font-size: 13px;
      font-weight: 700;
      transition: .22s ease;
    }

    .btn-primary {
      background: var(--lime);
      color: #080909;
      box-shadow: 0 12px 30px rgba(183,255,0,.12);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 35px rgba(183,255,0,.2);
    }

    .btn-secondary {
      background: var(--card);
      color: var(--text);
      border: 1px solid var(--line);
    }

    .btn-secondary:hover {
      transform: translateY(-2px);
      border-color: rgba(183,255,0,.3);
    }

    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 28px;
      margin-top: 48px;
    }

    .stat strong {
      display: block;
      font-family: "Space Grotesk", sans-serif;
      font-size: 25px;
    }

    .stat span {
      color: var(--muted);
      font-size: 11px;
    }

    /* =========================
       HERO VISUAL
    ========================= */

    .hero-visual {
      position: relative;
      min-height: 500px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .orb {
      position: absolute;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      background: rgba(183,255,0,.07);
      filter: blur(5px);
    }

    .showcase-card {
      position: relative;
      width: min(500px, 100%);
      padding: 12px;
      border: 1px solid var(--line);
      background: rgba(20,23,24,.72);
      border-radius: 25px;
      box-shadow: var(--shadow);
      transform: perspective(1000px) rotateY(-7deg) rotateX(3deg);
      animation: floatCard 5s ease-in-out infinite;
    }

    body.light .showcase-card {
      background: rgba(255,255,255,.84);
    }

    @keyframes floatCard {
      0%,100% { transform: perspective(1000px) rotateY(-7deg) rotateX(3deg) translateY(0); }
      50% { transform: perspective(1000px) rotateY(-7deg) rotateX(3deg) translateY(-10px); }
    }

    .browser-bar {
      height: 38px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      border-bottom: 1px solid var(--line);
    }

    .browser-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--muted);
    }

    .browser-url {
      margin-left: 7px;
      height: 21px;
      flex: 1;
      border-radius: 6px;
      background: var(--lime-soft);
      color: var(--muted);
      font-size: 9px;
      display: flex;
      align-items: center;
      padding: 0 9px;
    }

    .fake-site {
      height: 370px;
      overflow: hidden;
      border-radius: 16px;
      margin-top: 10px;
      background:
        linear-gradient(135deg, rgba(183,255,0,.22), transparent 38%),
        linear-gradient(160deg, #1a1e1d, #0c0e0e);
      position: relative;
    }

    .fake-site::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        transparent,
        rgba(0,0,0,.42)
      );
    }

    .fake-site-content {
      position: absolute;
      z-index: 2;
      left: 32px;
      right: 32px;
      bottom: 32px;
    }

    .fake-site-content small {
      color: var(--lime);
      font-weight: 700;
      letter-spacing: 2px;
    }

    .fake-site-content h3 {
      font-family: "Space Grotesk", sans-serif;
      font-size: 37px;
      margin-top: 9px;
    }

    .fake-site-content p {
      color: #aeb7b4;
      font-size: 12px;
      margin-top: 8px;
    }

    /* =========================
       SECTION
    ========================= */

    section {
      padding: 95px 0;
      scroll-margin-top: 76px;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 25px;
      margin-bottom: 35px;
    }

    .section-kicker {
      color: var(--lime);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .section-head h2 {
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(31px, 4vw, 52px);
      letter-spacing: -2.5px;
    }

    .section-head p {
      color: var(--muted);
      max-width: 480px;
      line-height: 1.7;
      font-size: 13px;
    }

    /* =========================
       PACKAGE
    ========================= */

    .package-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .package-card {
      position: relative;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
      padding: 28px;
      min-height: 480px;
      box-shadow: var(--shadow);
      overflow: hidden;
      transition: .25s ease;
    }

    .package-card:hover {
      transform: translateY(-6px);
      border-color: rgba(183,255,0,.3);
    }

    .package-card.featured {
      border-color: rgba(183,255,0,.32);
    }

    .popular {
      position: absolute;
      top: 20px;
      right: 20px;
      padding: 6px 9px;
      background: var(--lime);
      color: #080909;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .8px;
    }

    .package-name {
      color: var(--lime);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .package-card h3 {
      font-family: "Space Grotesk", sans-serif;
      font-size: 30px;
      margin-top: 10px;
    }

    .price {
      margin-top: 22px;
      font-family: "Space Grotesk", sans-serif;
      font-size: 38px;
      font-weight: 700;
    }

    .price span {
      color: var(--muted);
      font-family: "Inter", sans-serif;
      font-size: 12px;
      font-weight: 500;
    }

    .package-desc {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
      min-height: 52px;
      margin-top: 10px;
    }

    .features {
      list-style: none;
      margin: 23px 0;
      display: grid;
      gap: 11px;
    }

    .features li {
      display: flex;
      gap: 9px;
      color: var(--muted);
      font-size: 11px;
    }

    .features li::before {
      content: "✓";
      color: var(--lime);
      font-weight: 900;
    }

    .package-buttons {
      position: absolute;
      bottom: 26px;
      left: 28px;
      right: 28px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
    }

    /* =========================
       WEBSITES
    ========================= */

    .website-toolbar {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 24px;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .filter-btn {
      white-space: nowrap;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--muted);
      padding: 10px 15px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .filter-btn.active,
    .filter-btn:hover {
      background: var(--lime);
      color: #080909;
      border-color: var(--lime);
    }

    .website-scroll-wrap {
      position: relative;
    }

    .website-track {
      display: flex;
      gap: 18px;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding: 8px 2px 25px;
      scroll-snap-type: x mandatory;
    }

    .website-track::-webkit-scrollbar {
      display: none;
    }

    .website-card {
      flex: 0 0 350px;
      scroll-snap-align: start;
      border: 1px solid var(--line);
      background: var(--card);
      border-radius: 23px;
      padding: 10px;
      box-shadow: var(--shadow);
      transition: .25s ease;
    }

    .website-card:hover {
      transform: translateY(-5px);
      border-color: rgba(183,255,0,.28);
    }

    .website-preview {
      height: 225px;
      border-radius: 17px;
      overflow: hidden;
      position: relative;
      background:
        linear-gradient(135deg, rgba(183,255,0,.17), transparent),
        #151918;
    }

    .preview-screen {
      width: 100%;
      height: 100%;
      border: 0;
      background: #111;
    }

    .preview-fallback {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 25px;
      background:
        radial-gradient(circle at center, rgba(183,255,0,.15), transparent 55%),
        #111;
    }

    .preview-fallback strong {
      font-family: "Space Grotesk", sans-serif;
      font-size: 23px;
    }

    .preview-fallback span {
      color: var(--muted);
      font-size: 10px;
      margin-top: 6px;
    }

    .website-info {
      padding: 17px 9px 8px;
    }

    .website-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .website-meta span {
      color: var(--lime);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .live-status {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: #79e26c !important;
    }

    .live-status::before {
      content: "";
      width: 5px;
      height: 5px;
      background: #79e26c;
      border-radius: 50%;
    }

    .website-info h3 {
      margin-top: 9px;
      font-family: "Space Grotesk", sans-serif;
      font-size: 21px;
    }

    .website-url {
      margin-top: 5px;
      color: var(--muted);
      font-size: 9px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .website-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 15px;
    }

    .scroll-controls {
      display: flex;
      gap: 8px;
    }

    .scroll-controls button {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--text);
    }

    /* =========================
       SALAH
    ========================= */

    .salah-box {
      border: 1px solid var(--line);
      background:
        radial-gradient(circle at 100% 0%, rgba(183,255,0,.09), transparent 32%),
        var(--card);
      border-radius: var(--radius);
      padding: 30px;
      box-shadow: var(--shadow);
    }

    .salah-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 25px;
    }

    .salah-top h3 {
      font-family: "Space Grotesk", sans-serif;
      font-size: 27px;
    }

    .salah-top p {
      color: var(--muted);
      font-size: 11px;
      margin-top: 4px;
    }

    .location-badge {
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 9px 12px;
      color: var(--muted);
      font-size: 10px;
    }

    .prayer-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }

    .prayer {
      border: 1px solid var(--line);
      background: var(--bg-soft);
      border-radius: 17px;
      padding: 18px 12px;
      text-align: center;
    }

    .prayer small {
      color: var(--muted);
      font-size: 10px;
    }

    .prayer strong {
      display: block;
      margin-top: 9px;
      font-family: "Space Grotesk", sans-serif;
      font-size: 20px;
    }

    .prayer.active {
      border-color: rgba(183,255,0,.35);
      background: var(--lime-soft);
    }

    .prayer.active strong {
      color: var(--lime);
    }

    /* =========================
       ABOUT
    ========================= */

    .about-grid {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 35px;
      align-items: stretch;
    }

    .about-card {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
      padding: 32px;
      box-shadow: var(--shadow);
    }

    .about-card h3 {
      font-family: "Space Grotesk", sans-serif;
      font-size: 28px;
    }

    .about-card p {
      margin-top: 15px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.8;
    }

    .about-list {
      margin-top: 25px;
      display: grid;
      gap: 12px;
    }

    .about-list div {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--muted);
      font-size: 12px;
    }

    .about-list b {
      color: var(--lime);
    }

    /* =========================
       SUPPORT
    ========================= */

    .support {
      text-align: center;
    }

    .support-card {
      border: 1px solid var(--line);
      border-radius: 32px;
      background:
        radial-gradient(circle at center, rgba(183,255,0,.09), transparent 45%),
        var(--card);
      padding: 65px 25px;
      box-shadow: var(--shadow);
    }

    .support-card h2 {
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(34px, 5vw, 58px);
      letter-spacing: -2px;
    }

    .support-card p {
      max-width: 570px;
      margin: 15px auto 25px;
      color: var(--muted);
      line-height: 1.7;
      font-size: 13px;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      border-top: 1px solid var(--line);
      padding: 30px 0;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: center;
    }

    .footer-inner p {
      color: var(--muted);
      font-size: 10px;
    }

    .footer-links {
      display: flex;
      gap: 15px;
      color: var(--muted);
      font-size: 10px;
    }

    /* =========================
       PRESENTATION MODAL
    ========================= */

    .presentation {
      position: fixed;
      inset: 0;
      z-index: 3000;
      background: rgba(3,4,4,.96);
      display: none;
      flex-direction: column;
    }

    .presentation.open {
      display: flex;
    }

    .presentation-header {
      min-height: 66px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .presentation-title strong {
      font-family: "Space Grotesk", sans-serif;
      font-size: 16px;
    }

    .presentation-title span {
      display: block;
      color: #858d8a;
      font-size: 9px;
      margin-top: 3px;
    }

    .presentation-actions {
      display: flex;
      gap: 7px;
    }

    .presentation-stage {
      flex: 1;
      min-height: 0;
      display: grid;
      place-items: center;
      padding: 35px;
      overflow: hidden;
    }

    .device {
      width: min(1100px, 90vw);
      height: min(650px, 72vh);
      border: 9px solid #202423;
