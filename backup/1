<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Website Deals | Live Website Showcase</title>

  <meta
    name="description"
    content="Website Deals — Live website showcase and premium client presentation wall."
  />

  <meta name="theme-color" content="#080909" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --bg: #080909;
      --bg-soft: #101212;
      --card: #111414;
      --card-2: #151919;
      --text: #f5f7f6;
      --muted: #9aa3a0;
      --line: rgba(255,255,255,.09);
      --lime: #b7ff00;
      --lime-soft: rgba(183,255,0,.12);
      --green: #4ade80;
      --danger: #ff5c5c;
      --shadow: 0 30px 100px rgba(0,0,0,.45);
      --radius: 28px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 15% 10%, rgba(183,255,0,.07), transparent 28%),
        radial-gradient(circle at 85% 25%, rgba(80,255,170,.045), transparent 25%),
        var(--bg);
      color: var(--text);
      font-family: Inter, "Hind Siliguri", sans-serif;
      overflow-x: hidden;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* =========================
       BACKGROUND
    ========================= */

    .ambient {
      position: fixed;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: -1;
    }

    .ambient::before,
    .ambient::after {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      filter: blur(100px);
      opacity: .08;
    }

    .ambient::before {
      top: -180px;
      left: -100px;
      background: var(--lime);
    }

    .ambient::after {
      right: -140px;
      bottom: -180px;
      background: #5eead4;
    }

    /* =========================
       HEADER
    ========================= */

    .topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid var(--line);
      background: rgba(8,9,9,.82);
      backdrop-filter: blur(22px);
    }

    .nav {
      width: min(1400px, calc(100% - 36px));
      min-height: 76px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-mark {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: var(--lime);
      color: #080909;
      font-weight: 900;
      box-shadow: 0 0 35px rgba(183,255,0,.16);
    }

    .brand-text strong {
      display: block;
      font-size: 15px;
      letter-spacing: -.02em;
    }

    .brand-text span {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 11px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .clock {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 13px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      font-size: 12px;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 12px rgba(74,222,128,.8);
      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      0%,100% {
        transform: scale(1);
        opacity: 1;
      }
      50% {
        transform: scale(.65);
        opacity: .55;
      }
    }

    .icon-btn {
      width: 42px;
      height: 42px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: rgba(255,255,255,.025);
      color: var(--text);
      transition: .25s ease;
    }

    .icon-btn:hover {
      border-color: rgba(183,255,0,.35);
      background: var(--lime-soft);
      color: var(--lime);
      transform: translateY(-2px);
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      width: min(1400px, calc(100% - 36px));
      margin: auto;
      padding: 85px 0 45px;
      display: grid;
      grid-template-columns: 1.25fr .75fr;
      align-items: end;
      gap: 50px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(183,255,0,.18);
      background: rgba(183,255,0,.06);
      border-radius: 999px;
      color: var(--lime);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    h1 {
      max-width: 900px;
      margin-top: 20px;
      font-size: clamp(48px, 7vw, 96px);
      line-height: .91;
      letter-spacing: -.065em;
    }

    h1 span {
      color: var(--lime);
    }

    .hero-copy {
      max-width: 650px;
      margin-top: 24px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.8;
    }

    .hero-side {
      padding-bottom: 8px;
    }

    .hero-side-card {
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: 22px;
      background: rgba(255,255,255,.025);
    }

    .hero-side-card small {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .12em;
    }

    .hero-side-card strong {
      display: block;
      margin-top: 10px;
      font-size: 25px;
      letter-spacing: -.04em;
    }

    .hero-side-card p {
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }

    /* =========================
       FILTER BAR
    ========================= */

    .showcase {
      width: min(1400px, calc(100% - 36px));
      margin: auto;
      padding-bottom: 100px;
    }

    .section-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
    }

    .section-title h2 {
      font-size: 25px;
      letter-spacing: -.04em;
    }

    .section-title p {
      margin-top: 5px;
      color: var(--muted);
      font-size: 12px;
    }

    .filters {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }

    .filter {
      border: 1px solid var(--line);
      background: rgba(255,255,255,.025);
      color: var(--muted);
      border-radius: 999px;
      padding: 9px 14px;
      font-size: 12px;
      transition: .2s ease;
    }

    .filter:hover,
    .filter.active {
      color: #080909;
      border-color: var(--lime);
      background: var(--lime);
    }

    /* =========================
       WEBSITE GRID
    ========================= */

    .website-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 22px;
    }

    .website-card {
      position: relative;
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background:
        linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.012)),
        var(--card);
      box-shadow: 0 18px 60px rgba(0,0,0,.22);
      transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;
    }

    .website-card:hover {
      transform: translateY(-7px);
      border-color: rgba(183,255,0,.25);
      box-shadow: var(--shadow);
    }

    .preview {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: #0d1010;
      border-bottom: 1px solid var(--line);
    }

    .preview::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(
          120deg,
          rgba(255,255,255,.08),
          transparent 32%,
          transparent 68%,
          rgba(183,255,0,.04)
        );
    }

    .browser-bar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 4;
      height: 31px;
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 0 10px;
      border-bottom: 1px solid rgba(0,0,0,.12);
      background: rgba(245,245,245,.94);
    }

    .browser-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #bbb;
    }

    .browser-address {
      flex: 1;
      height: 17px;
      margin-left: 6px;
      padding: 2px 8px;
      border-radius: 999px;
      background: #e8e8e8;
      color: #666;
      font-size: 7px;
      overflow: hidden;
      white-space: nowrap;
    }

    .website-frame {
      position: absolute;
      top: 31px;
      left: 0;
      width: 100%;
      height: calc(100% - 31px);
      border: 0;
      background: white;
      transform-origin: top center;
    }

    .preview-placeholder {
      position: absolute;
      inset: 31px 0 0;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at center, rgba(183,255,0,.09), transparent 38%),
        #0e1111;
      color: var(--muted);
      font-size: 12px;
      text-align: center;
      padding: 20px;
    }

    .preview-placeholder strong {
      display: block;
      color: var(--text);
      margin-bottom: 7px;
    }

    .card-content {
      padding: 18px;
    }

    .package-badge {
      display: inline-flex;
      padding: 6px 9px;
      border-radius: 999px;
      background: rgba(183,255,0,.08);
      color: var(--lime);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .card-title {
      margin-top: 12px;
      font-size: 19px;
      letter-spacing: -.035em;
    }

    .card-url {
      margin-top: 6px;
      color: var(--muted);
      font-size: 11px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .card-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 17px;
    }

    .btn {
      min-height: 43px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: rgba(255,255,255,.035);
      color: var(--text);
      font-weight: 700;
      font-size: 12px;
      transition: .2s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
      border-color: rgba(183,255,0,.35);
    }

    .btn-primary {
      border-color: var(--lime);
      background: var(--lime);
      color: #080909;
    }

    .btn-primary:hover {
      box-shadow: 0 12px 35px rgba(183,255,0,.18);
    }

    /* =========================
       EMPTY
    ========================= */

    .empty {
      display: none;
      padding: 80px 20px;
      border: 1px dashed var(--line);
      border-radius: 25px;
      text-align: center;
      color: var(--muted);
    }

    .empty strong {
      display: block;
      margin-bottom: 7px;
      color: var(--text);
    }

    /* =========================
       PRESENTATION
    ========================= */

    .presentation {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: none;
      background:
        radial-gradient(circle at 50% 20%, rgba(183,255,0,.08), transparent 32%),
        #050606;
      overflow: hidden;
    }

    .presentation.open {
      display: block;
      animation: presentationIn .45s ease both;
    }

    @keyframes presentationIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    .presentation-top {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 30;
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 25px;
      background: linear-gradient(
        180deg,
        rgba(0,0,0,.72),
        transparent
      );
      pointer-events: none;
    }

    .presentation-top > * {
      pointer-events: auto;
    }

    .presentation-brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .presentation-brand-mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--lime);
      color: #080909;
      font-weight: 900;
      font-size: 12px;
    }

    .presentation-brand-text strong {
      display: block;
      font-size: 12px;
    }

    .presentation-brand-text span {
      display: block;
      margin-top: 2px;
      color: rgba(255,255,255,.5);
      font-size: 9px;
    }

    .presentation-controls {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .presentation-btn {
      height: 38px;
      padding: 0 13px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 11px;
      background: rgba(255,255,255,.055);
      color: white;
      font-size: 11px;
      font-weight: 700;
      backdrop-filter: blur(12px);
      transition: .2s ease;
    }

    .presentation-btn:hover {
      background: rgba(255,255,255,.11);
      border-color: rgba(183,255,0,.4);
    }

    .presentation-btn.lime {
      background: var(--lime);
      color: #080909;
      border-color: var(--lime);
    }

    .presentation-stage {
      position: absolute;
      inset: 76px 30px 88px;
      display: flex;
      align-items: center;
      justify-content: center;
      perspective: 1400px;
    }

    .desktop-device {
      position: relative;
      width: min(1180px, 90vw);
      aspect-ratio: 16 / 10;
      padding: 12px 12px 38px;
      border-radius: 20px;
      background:
        linear-gradient(145deg, #252a2a, #0b0d0d);
      border: 1px solid rgba(255,255,255,.16);
      box-shadow:
        0 50px 120px rgba(0,0,0,.72),
        0 0 0 1px rgba(255,255,255,.03);
      transform-style: preserve-3d;
      transition: transform .8s cubic-bezier(.2,.8,.2,1);
    }

    .desktop-device.scale-in {
      animation: deviceScale .8s cubic-bezier(.2,.8,.2,1);
    }

    @keyframes deviceScale {
      0% {
        transform: scale(.88) translateY(25px);
        opacity: 0;
      }
      100% {
        transform: scale(1) translateY(0);
        opacity: 1;
      }
    }

    .desktop-screen {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 11px;
      background: white;
    }

    .desktop-screen iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
      background: white;
    }

    .device-camera {
      position: absolute;
      top: 5px;
      left: 50%;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #060707;
      transform: translateX(-50%);
    }

    .device-bottom {
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 150px;
      height: 23px;
      transform: translateX(-50%);
      display: grid;
      place-items: center;
      color: rgba(255,255,255,.18);
      font-size: 7px;
      letter-spacing: .12em;
    }

    .device-stand {
      position: absolute;
      left: 50%;
      bottom: -55px;
      width: 140px;
      height: 60px;
      transform: translateX(-50%);
      background: linear-gradient(90deg,#0d0f0f,#222626,#0d0f0f);
      clip-path: polygon(35% 0,65% 0,78% 85%,100% 100%,0 100%,22% 85%);
      z-index: -1;
    }

    .presentation-info {
      position: absolute;
      left: 30px;
      right: 30px;
      bottom: 22px;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .presentation-site {
      min-width: 0;
    }

    .presentation-site small {
      display: block;
      color: var(--lime);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .presentation-site strong {
      display: block;
      margin-top: 4px;
      font-size: 20px;
      letter-spacing: -.035em;
    }

    .presentation-site span {
      display: block;
      margin-top: 3px;
      max-width: 500px;
      color: rgba(255,255,255,.4);
      font-size: 10px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .presentation-progress {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .progress-line {
      width: 130px;
      height: 3px;
      overflow: hidden;
      border-radius: 99px;
      background: rgba(255,255,255,.12);
    }

    .progress-fill {
      width: 0%;
      height: 100%;
      background: var(--lime);
      transition: width .2s linear;
    }

    .counter {
      color: rgba(255,255,255,.45);
      font-size: 10px;
      white-space: nowrap;
    }

    /* Presentation transitions */

    .desktop-device.slide-next {
      animation: slideNext .7s cubic-bezier(.2,.8,.2,1);
    }

    @keyframes slideNext {
      0% {
        opacity: 0;
        transform: translateX(100px) scale(.96);
      }
      100% {
        opacity: 1;
        transform: translateX(0) scale(1);
      }
    }

    .desktop-device.slide-prev {
      animation: slidePrev .7s cubic-bezier(.2,.8,.2,1);
    }

    @keyframes slidePrev {
      0% {
        opacity: 0;
        transform: translateX(-100px) scale(.96);
      }
      100% {
        opacity: 1;
        transform: translateX(0) scale(1);
      }
    }

    .desktop-device.float-mode {
      animation: floatDevice 5s ease-in-out infinite;
    }

    @keyframes floatDevice {
      0%,100% {
        transform: translateY(0) rotateX(0deg);
      }
      50% {
        transform: translateY(-8px) rotateX(.4deg);
      }
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      width: min(1400px, calc(100% - 36px));
      margin: auto;
      padding: 30px 0 50px;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      color: var(--muted);
      font-size: 11px;
    }

    footer strong {
      color: var(--text);
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 1050px) {
      .hero {
        grid-template-columns: 1fr;
        padding-top: 65px;
      }

      .website-grid {
        grid-template-columns: repeat(2, minmax(0,1fr));
      }

      .desktop-device {
        width: min(900px, 92vw);
      }
    }

    @media (max-width: 700px) {
      .nav {
        width: min(100% - 22px, 1400px);
      }

      .clock {
        display: none;
      }

      .hero,
      .showcase,
      footer {
        width: calc(100% - 22px);
      }

      .hero {
        padding: 55px 0 35px;
      }

      h1 {
        font-size: 51px;
      }

      .website-grid {
        grid-template-columns: 1fr;
      }

      .section-bar {
        align-items: flex-start;
        flex-direction: column;
      }

      .presentation-top {
        height: 65px;
        padding: 0 12px;
      }

      .presentation-stage {
        inset: 65px 10px 115px;
      }

      .desktop-device {
        width: 96vw;
        border-radius: 13px;
        padding: 7px 7px 25px;
      }

      .device-stand,
      .device-bottom {
        display: none;
      }

      .presentation-info {
        left: 12px;
        right: 12px;
        bottom: 14px;
        align-items: flex-end;
      }

      .presentation-site strong {
        font-size: 15px;
      }

      .presentation-site span {
        max-width: 210px;
      }

      .presentation-progress {
        flex-direction: column;
        align-items: flex-end;
      }

      .progress-line {
        width: 90px;
      }

      .presentation-btn.text-btn {
        display: none;
      }

      footer {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <div class="ambient"></div>

  <!-- =========================
       HEADER
  ========================= -->

  <header class="topbar">
    <nav class="nav">

      <a class="brand" href="../index.html">
        <div class="brand-mark">WD</div>

        <div class="brand-text">
          <strong>Website Deals</strong>
          <span>Live Website Showcase</span>
        </div>
      </a>

      <div class="nav-actions">

        <div class="clock">
          <span class="live-dot"></span>
          <span id="clockText">LIVE</span>
        </div>

        <button
          class="icon-btn"
          type="button"
          title="Admin"
          onclick="openAdmin()"
        >
          ⚙
        </button>

      </div>

    </nav>
  </header>

  <!-- =========================
       HERO
  ========================= -->

  <main>

    <section class="hero">

      <div>

        <div class="eyebrow">
          <span class="live-dot"></span>
          Personal Client Showcase
        </div>

        <h1>
          Your websites.<br />
          <span>Live. Anywhere.</span>
        </h1>

        <p class="hero-copy">
          আপনার সব real website এক জায়গায়। Client-এর সামনে laptop,
          desktop অথবা tablet খুলেই Explore করুন — premium presentation
          mode-এ website দেখান।
        </p>

      </div>

      <div class="hero-side">

        <div class="hero-side-card">
          <small>Presentation Mode</small>
          <strong>Explore → Full Screen</strong>
          <p>
            Smart sound, smooth scale, slide transition এবং live website
            presentation — সব একসাথে।
          </p>
        </div>

      </div>

    </section>

    <!-- =========================
         SHOWCASE
    ========================= -->

    <section class="showcase">

      <div class="section-bar">

        <div class="section-title">
          <h2>Live Website Wall</h2>
          <p id="websiteCount">0 websites available</p>
        </div>

        <div class="filters">

          <button
            class="filter active"
            data-filter="all"
            type="button"
          >
            All
          </button>

          <button
            class="filter"
            data-filter="starter"
            type="button"
          >
            Starter
          </button>

          <button
            class="filter"
            data-filter="business"
            type="button"
          >
            Business
          </button>

          <button
            class="filter"
            data-filter="premium"
            type="button"
          >
            Premium
          </button>

        </div>

      </div>

      <div
        class="website-grid"
        id="websiteGrid"
      ></div>

      <div
        class="empty"
        id="emptyState"
      >
        <strong>No websites found</strong>
        No website has been added to this package yet.
      </div>

    </section>

  </main>

  <footer>

    <div>
      <strong>Website Deals</strong>
      — Live Client Presentation Wall
    </div>

    <div>
      Explore • Present • Sell
    </div>

  </footer>

  <!-- =========================
       PRESENTATION
  ========================= -->

  <section
    class="presentation"
    id="presentation"
    aria-hidden="true"
  >

    <div class="presentation-top">

      <div class="presentation-brand">

        <div class="presentation-brand-mark">
          WD
        </div>

        <div class="presentation-brand-text">
          <strong>Website Deals</strong>
          <span>LIVE PRESENTATION</span>
        </div>

      </div>

      <div class="presentation-controls">

        <button
          class="presentation-btn"
          type="button"
          onclick="previousWebsite()"
          title="Previous website"
        >
          ←
        </button>

        <button
          class="presentation-btn"
          type="button"
          onclick="toggleAutoPlay()"
          id="autoButton"
        >
          ▶ Auto
        </button>

        <button
          class="presentation-btn"
          type="button"
          onclick="toggleSound()"
          id="soundButton"
        >
          🔊 Sound
        </button>

        <button
          class="presentation-btn text-btn"
          type="button"
          onclick="openCurrentWebsite()"
        >
          Open Live
        </button>

        <button
          class="presentation-btn"
          type="button"
          onclick="toggleFullscreen()"
        >
          ⛶
        </button>

        <button
          class="presentation-btn"
          type="button"
          onclick="closePresentation()"
        >
          ✕
        </button>

        <button
          class="presentation-btn"
          type="button"
          onclick="nextWebsite()"
          title="Next website"
        >
          →
        </button>

      </div>

    </div>

    <div class="presentation-stage">

      <div
        class="desktop-device"
        id="desktopDevice"
      >

        <div class="device-camera"></div>

        <div class="desktop-screen">

          <iframe
            id="presentationFrame"
            title="Live Website Presentation"
            allow="autoplay; fullscreen"
          ></iframe>

        </div>

        <div class="device-bottom">
          WEBSITE DEALS
        </div>

        <div class="device-stand"></div>

      </div>

    </div>

    <div class="presentation-info">

      <div class="presentation-site">

        <small id="presentationPackage">
          BUSINESS PACKAGE
        </small>

        <strong id="presentationName">
          Website
        </strong>

        <span id="presentationUrl">
          https://example.com
        </span>

      </div>

      <div class="presentation-progress">

        <div class="progress-line">
          <div
            class="progress-fill"
            id="progressFill"
          ></div>
        </div>

        <div
          class="counter"
          id="presentationCounter"
        >
          1 / 1
        </div>

      </div>

    </div>

  </section>

  <script>
    /* =========================================================
       WEBSITE DATA
       ========================================================= */

    const DEFAULT_WEBSITES = [
      {
        id: "snk-it-institute",
        name: "SNK IT Institute",
        package: "business",
        packageLabel: "Business Package",
        url: "https://snkitinstitute.com",
        animation: "zoom",
        status: true,
        sort: 1
      }
    ];

    const STORAGE_KEY = "websiteDealsWebsites";

    let websites = [];
    let currentFilter = "all";

    let presentationWebsites = [];
    let currentIndex = 0;

    let autoPlay = false;
    let autoTimer = null;
    let progressTimer = null;

    let soundEnabled = true;

    let audioContext = null;

    const AUTO_DURATION = 8000;

    /* =========================================================
       LOAD DATA
       ========================================================= */

    function loadWebsites() {

      try {

        const saved = localStorage.getItem(STORAGE_KEY);

        if (saved) {

          const parsed = JSON.parse(saved);

          if (Array.isArray(parsed)) {
            websites = parsed;
          } else {
            websites = [...DEFAULT_WEBSITES];
          }

        } else {

          websites = [...DEFAULT_WEBSITES];

          localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(websites)
          );
        }

      } catch (error) {

        websites = [...DEFAULT_WEBSITES];

      }

      websites = websites
        .filter(site => site && site.status !== false)
        .sort((a,b) => {
          return Number(a.sort || 0) - Number(b.sort || 0);
        });

    }

    /* =========================================================
       CLOCK
       ========================================================= */

    function updateClock() {

      const el = document.getElementById("clockText");

      if (!el) return;

      const now = new Date();

      const time = now.toLocaleTimeString(
        "en-BD",
        {
          hour: "2-digit",
          minute: "2-digit"
        }
      );

      el.textContent = time;

    }

    setInterval(updateClock, 1000);
    updateClock();

    /* =========================================================
       PACKAGE HELPERS
       ========================================================= */

    function getPackageLabel(packageName) {

      const labels = {
        starter: "Starter Package",
        business: "Business Package",
        premium: "Premium Package"
      };

      return labels[packageName] || "Website Package";

    }

    function escapeHTML(value) {

      return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    }

    /* =========================================================
       RENDER
       ========================================================= */

    function renderWebsites() {

      const grid = document.getElementById("websiteGrid");
      const empty = document.getElementById("emptyState");
      const count = document.getElementById("websiteCount");

      if (!grid) return;

      const filtered = websites.filter(site => {

        if (currentFilter === "all") {
          return true;
        }

        return site.package === currentFilter;

      });

      count.textContent =
        `${filtered.length} website${filtered.length === 1 ? "" : "s"} available`;

      if (!filtered.length) {

        grid.innerHTML = "";

        empty.style.display = "block";

        return;

      }

      empty.style.display = "none";

      grid.innerHTML = filtered.map((site, index) => {

        return `
          <article class="website-card">

            <div class="preview">

              <div class="browser-bar">

                <span class="browser-dot"></span>
                <span class="browser-dot"></span>
                <span class="browser-dot"></span>

                <div class="browser-address">
                  ${escapeHTML(site.url)}
                </div>

              </div>

              <iframe
                class="website-frame"
                src="${escapeHTML(site.url)}"
                title="${escapeHTML(site.name)}"
                loading="lazy"
                allow="fullscreen"
              ></iframe>

            </div>

            <div class="card-content">

              <span class="package-badge">
                ${escapeHTML(site.packageLabel || getPackageLabel(site.package))}
              </span>

              <h3 class="card-title">
                ${escapeHTML(site.name)}
              </h3>

              <div class="card-url">
                ${escapeHTML(site.url)}
              </div>

              <div class="card-actions">

                <button
                  class="btn btn-primary"
                  type="button"
                  onclick="exploreWebsite('${escapeHTML(site.id)}')"
                >
                  ✦ Explore
                </button>

                <button
                  class="btn"
                  type="button"
                  onclick="openWebsite('${escapeHTML(site.id)}')"
                >
                  ↗ Open Live
                </button>

              </div>

            </div>

          </article>
        `;

      }).join("");

    }

    /* =========================================================
       FILTER
       ========================================================= */

    document.querySelectorAll(".filter").forEach(button => {

      button.addEventListener("click", () => {

        document
          .querySelectorAll(".filter")
          .forEach(btn => btn.classList.remove("active"));

        button.classList.add("active");

        currentFilter = button.dataset.filter;

        renderWebsites();

      });

    });

    /* =========================================================
       FIND WEBSITE
       ========================================================= */

    function findWebsite(id) {

      return websites.find(site => site.id === id);

    }

    /* =========================================================
       OPEN LIVE WEBSITE
       ========================================================= */

    function openWebsite(id) {

      const site = findWebsite(id);

      if (!site) return;

      window.open(
        site.url,
        "_blank",
        "noopener,noreferrer"
      );

      playSound("open");

    }

    /* =========================================================
       AUDIO ENGINE
       ========================================================= */

    function initAudio() {

      if (audioContext) return;

      try {

        audioContext =
          new (window.AudioContext || window.webkitAudioContext)();

      } catch (error) {

        audioContext = null;

      }

    }

    function playSound(type = "transition") {

      if (!soundEnabled) return;

      initAudio();

      if (!audioContext) return;

      if (audioContext.state === "suspended") {
        audioContext.resume();
      }

      const now = audioContext.currentTime;

      const oscillator =
        audioContext.createOscillator();

      const gain =
        audioContext.createGain();

      oscillator.connect(gain);
      gain.connect(audioContext.destination);

      let frequency = 520;
      let duration = .13;

      if (type === "open") {
        frequency = 620;
        duration = .18;
      }

      if (type === "next") {
        frequency = 740;
        duration = .12;
      }

      if (type === "previous") {
        frequency = 430;
        duration = .12;
      }

      if (type === "close") {
        frequency = 300;
        duration = .16;
      }

      oscillator.type = "sine";

      oscillator.frequency.setValueAtTime(
        frequency,
        now
      );

      oscillator.frequency.exponentialRampToValueAtTime(
        frequency * .72,
        now + duration
      );

      gain.gain.setValueAtTime(
        0.0001,
        now
      );

      gain.gain.exponentialRampToValueAtTime(
        0.035,
        now + .025
      );

      gain.gain.exponentialRampToValueAtTime(
        0.0001,
        now + duration
      );

      oscillator.start(now);
      oscillator.stop(now + duration + .02);

    }

    /* =========================================================
       EXPLORE
    ========================================================= */

    function exploreWebsite(id) {

      const index =
        websites.findIndex(site => site.id === id);

      if (index === -1) return;

      presentationWebsites = [...websites];

      currentIndex = index;

      const presentation =
        document.getElementById("presentation");

      presentation.classList.add("open");

      presentation.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.style.overflow = "hidden";

      initAudio();
      playSound("open");

      showPresentationWebsite("next");

      setTimeout(() => {

        requestFullscreenPresentation();

      }, 180);

    }

    /* =========================================================
       SHOW PRESENTATION WEBSITE
    ========================================================= */

    function showPresentationWebsite(direction = "next") {

      if (!presentationWebsites.length) return;

      const site =
        presentationWebsites[currentIndex];

      const frame =
        document.getElementById("presentationFrame");

      const device =
        document.getElementById("desktopDevice");

      const name =
        document.getElementById("presentationName");

      const url =
        document.getElementById("presentationUrl");

      const packageLabel =
        document.getElementById("presentationPackage");

      const counter =
        document.getElementById("presentationCounter");

      frame.src = site.url;

      name.textContent = site.name || "Website";

      url.textContent = site.url || "";

      packageLabel.textContent =
        site.packageLabel ||
        getPackageLabel(site.package);

      counter.textContent =
        `${currentIndex + 1} / ${presentationWebsites.length}`;

      device.classList.remove(
        "scale-in",
        "slide-next",
        "slide-prev",
        "float-mode"
      );

      void device.offsetWidth;

      const animation =
        site.animation || "zoom";

      if (animation === "slide") {

        device.classList.add(
          direction === "previous"
            ? "slide-prev"
            : "slide-next"
        );

      } else if (animation === "float") {

        device.classList.add("float-mode");

      } else {

        device.classList.add("scale-in");

      }

      playSound(
        direction === "previous"
          ? "previous"
          : "next"
      );

      resetProgress();

      if (autoPlay) {
        startProgress();
      }

    }

    /* =========================================================
       NEXT
    ========================================================= */

    function nextWebsite() {

      if (!presentationWebsites.length) return;

      currentIndex++;

      if (currentIndex >= presentationWebsites.length) {
        currentIndex = 0;
      }

      showPresentationWebsite("next");

    }

    /* =========================================================
       PREVIOUS
    ========================================================= */

    function previousWebsite() {

      if (!presentationWebsites.length) return;

      currentIndex--;

      if (currentIndex < 0) {
        currentIndex =
          presentationWebsites.length - 1;
      }

      showPresentationWebsite("previous");

    }

    /* =========================================================
       AUTO PLAY
    ========================================================= */

    function toggleAutoPlay() {

      autoPlay = !autoPlay;

      const button =
        document.getElementById("autoButton");

      if (autoPlay) {

        button.textContent = "Ⅱ Auto";

        startAutoPlay();

      } else {

        button.textContent = "▶ Auto";

        stopAutoPlay();

      }

    }

    function startAutoPlay() {

      stopAutoPlay();

      startProgress();

      autoTimer = setInterval(() => {

        nextWebsite();

      }, AUTO_DURATION);

    }

    function stopAutoPlay() {

      if (autoTimer) {

        clearInterval(autoTimer);
        autoTimer = null;

      }

      if (progressTimer) {

        clearInterval(progressTimer);
        progressTimer = null;

      }

      const fill =
        document.getElementById("progressFill");

      if (fill) {
        fill.style.width = "0%";
      }

    }

    /* =========================================================
       PROGRESS
    ========================================================= */

    function resetProgress() {

      const fill =
        document.getElementById("progressFill");

      if (!fill) return;

      fill.style.width = "0%";

    }

    function startProgress() {

      if (!autoPlay) return;

      if (progressTimer) {
        clearInterval(progressTimer);
      }

      const fill =
        document.getElementById("progressFill");

      const started = Date.now();

      progressTimer = setInterval(() => {

        const elapsed =
          Date.now() - started;

        const percent =
          Math.min(
            100,
            (elapsed / AUTO_DURATION) * 100
          );

        fill.style.width =
          `${percent}%`;

      }, 60);

    }

    /* =========================================================
       SOUND
    ========================================================= */

    function toggleSound() {

      soundEnabled = !soundEnabled;

      const button =
        document.getElementById("soundButton");

      button.textContent =
        soundEnabled
          ? "🔊 Sound"
          : "🔇 Muted";

      if (soundEnabled) {

        initAudio();
        playSound("open");

      }

    }

    /* =========================================================
       OPEN CURRENT WEBSITE
    ========================================================= */

    function openCurrentWebsite() {

      const site =
        presentationWebsites[currentIndex];

      if (!site) return;

      window.open(
        site.url,
        "_blank",
        "noopener,noreferrer"
      );

      playSound("open");

    }

    /* =========================================================
       CLOSE PRESENTATION
    ========================================================= */

    function closePresentation() {

      stopAutoPlay();

      autoPlay = false;

      document.getElementById(
        "autoButton"
      ).textContent = "▶ Auto";

      const presentation =
        document.getElementById("presentation");

      presentation.classList.remove("open");

      presentation.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.style.overflow = "";

      playSound("close");

      exitFullscreen();

    }

    /* =========================================================
       FULLSCREEN
    ========================================================= */

    function requestFullscreenPresentation() {

      const element =
        document.getElementById("presentation");

      if (!document.fullscreenElement) {

        if (element.requestFullscreen) {

          element.requestFullscreen().catch(() => {});

        }

      }

    }

    function toggleFullscreen() {

      if (!document.fullscreenElement) {

        requestFullscreenPresentation();

      } else {

        exitFullscreen();

      }

    }

    function exitFullscreen() {

      if (document.fullscreenElement) {

        document.exitFullscreen().catch(() => {});

      }

    }

    /* =========================================================
       KEYBOARD CONTROLS
    ========================================================= */

    document.addEventListener("keydown", event => {

      const presentation =
        document.getElementById("presentation");

      const isOpen =
        presentation.classList.contains("open");

      if (!isOpen) return;

      if (event.key === "Escape") {

        closePresentation();

      }

      if (event.key === "ArrowRight") {

        nextWebsite();

      }

      if (event.key === "ArrowLeft") {

        previousWebsite();

      }

      if (
        event.key.toLowerCase() === "f"
      ) {

        toggleFullscreen();

      }

      if (
        event.key.toLowerCase() === "s"
      ) {

        toggleSound();

      }

      if (
        event.key === " "
      ) {

        event.preventDefault();

        toggleAutoPlay();

      }

    });

    /* =========================================================
       TOUCH SWIPE
    ========================================================= */

    let touchStartX = 0;

    document.addEventListener(
      "touchstart",
      event => {

        if (!document
          .getElementById("presentation")
          .classList.contains("open")) {
          return;
        }

        touchStartX =
          event.changedTouches[0].screenX;

      },
      { passive: true }
    );

    document.addEventListener(
      "touchend",
      event => {

        if (!document
          .getElementById("presentation")
          .classList.contains("open")) {
          return;
        }

        const touchEndX =
          event.changedTouches[0].screenX;

        const difference =
          touchEndX - touchStartX;

        if (Math.abs(difference) < 60) {
          return;
        }

        if (difference < 0) {
          nextWebsite();
        } else {
          previousWebsite();
        }

      },
      { passive: true }
    );

    /* =========================================================
       ADMIN
    ========================================================= */

    function openAdmin() {

      window.location.href =
        "admin/websites.html";

    }

    /* =========================================================
       INIT
    ========================================================= */

    loadWebsites();
    renderWebsites();

  </script>

