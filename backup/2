  <script>
    /* =========================================================
       WEBSITE DEALS
       LIVE MARKETING WALL
       package/index.html
       ========================================================= */

    const STORAGE_KEY = "websiteDealsWebsites";

    const defaultWebsites = [
      {
        id: "snk-it-institute",
        name: "SNK IT Institute",
        package: "business",
        packageLabel: "Business Package",
        url: "https://snkitinstitute.com",
        animation: "zoom",
        status: true,
        sort: 1
      }
    ];


    /* =========================================================
       STATE
       ========================================================= */

    let websites = [];
    let currentFilter = "all";
    let searchTerm = "";

    let presentationList = [];
    let presentationIndex = 0;

    let autoPlay = false;
    let soundEnabled = false;

    let autoTimer = null;
    let progressTimer = null;

    let progressStart = 0;
    const AUTO_DURATION = 8000;


    /* =========================================================
       DOM
       ========================================================= */

    const body = document.body;

    const websiteGrid =
      document.getElementById("websiteGrid");

    const emptyState =
      document.getElementById("emptyState");

    const visibleCount =
      document.getElementById("visibleCount");

    const searchInput =
      document.getElementById("searchInput");

    const searchClear =
      document.getElementById("searchClear");

    const themeBtn =
      document.getElementById("themeBtn");

    const pinBtn =
      document.getElementById("pinBtn");

    const pinText =
      document.getElementById("pinText");

    const mobileMenuBtn =
      document.getElementById("mobileMenuBtn");

    const navLinks =
      document.getElementById("navLinks");

    const presentation =
      document.getElementById("presentation");

    const presentationFrame =
      document.getElementById("presentationFrame");

    const presTitle =
      document.getElementById("presTitle");

    const presPackage =
      document.getElementById("presPackage");

    const presCounter =
      document.getElementById("presCounter");

    const progress =
      document.getElementById("progress");

    const soundBtn =
      document.getElementById("soundBtn");

    const autoBtn =
      document.getElementById("autoBtn");

    const fullscreenBtn =
      document.getElementById("fullscreenBtn");

    const playBtn =
      document.getElementById("playBtn");

    const prevBtn =
      document.getElementById("prevBtn");

    const nextBtn =
      document.getElementById("nextBtn");

    const liveBtn =
      document.getElementById("liveBtn");

    const closePresentation =
      document.getElementById("closePresentation");

    const nextPrayer =
      document.getElementById("nextPrayer");

    const clock =
      document.getElementById("clock");

    const date =
      document.getElementById("date");

    const toast =
      document.getElementById("toast");


    /* =========================================================
       INIT
       ========================================================= */

    function init() {

      loadWebsites();

      loadPreferences();

      renderWebsites();

      updateClock();

      setInterval(updateClock, 1000);

      updatePrayer();

      setInterval(updatePrayer, 30000);

      document.getElementById("year").textContent =
        new Date().getFullYear();

    }


    /* =========================================================
       LOAD WEBSITE DATA
       ========================================================= */

    function loadWebsites() {

      try {

        const saved =
          localStorage.getItem(STORAGE_KEY);

        if (saved) {

          const parsed =
            JSON.parse(saved);

          if (Array.isArray(parsed)) {

            websites = parsed.filter(
              item => item && item.status !== false
            );

          }

        }

      } catch (error) {

        console.warn(
          "Website data could not be loaded.",
          error
        );

      }

      if (!websites.length) {
        websites = [...defaultWebsites];
      }

      websites.sort(
        (a, b) =>
          Number(a.sort || 0) -
          Number(b.sort || 0)
      );
    }


    /* =========================================================
       FILTERED WEBSITES
       ========================================================= */

    function getFilteredWebsites() {

      return websites.filter(site => {

        const matchesFilter =
          currentFilter === "all" ||
          String(site.package).toLowerCase() ===
          currentFilter;

        const haystack = [
          site.name,
          site.url,
          site.package,
          site.packageLabel
        ]
          .join(" ")
          .toLowerCase();

        const matchesSearch =
          !searchTerm ||
          haystack.includes(
            searchTerm.toLowerCase()
          );

        return matchesFilter && matchesSearch;

      });

    }


    /* =========================================================
       RENDER WEBSITE CARDS
       ========================================================= */

    function renderWebsites() {

      const list =
        getFilteredWebsites();

      websiteGrid.innerHTML = "";

      visibleCount.textContent =
        list.length;

      if (!list.length) {

        emptyState.classList.add("show");

        return;

      }

      emptyState.classList.remove("show");


      list.forEach((site, index) => {

        const card =
          document.createElement("article");

        card.className =
          "website-card";

        card.dataset.index = index;


        const safeName =
          escapeHTML(
            site.name ||
            "Untitled Website"
          );

        const safePackage =
          escapeHTML(
            site.packageLabel ||
            `${site.package || "Package"} Package`
          );

        const safeUrl =
          escapeHTML(
            site.url ||
            "#"
          );

        const animation =
          escapeHTML(
            site.animation ||
            "zoom"
          );


        card.innerHTML = `

          <div class="preview">

            <iframe
              src="${safeUrl}"
              title="${safeName}"
              loading="lazy"
              sandbox="allow-forms allow-modals allow-popups allow-scripts allow-same-origin"
            ></iframe>

            <div class="preview-shade"></div>

            <div class="preview-top">

              <div class="package-badge">
                ${safePackage}
              </div>

              <div class="live-badge">
                <i></i>
                Live
              </div>

            </div>

            <div class="preview-bottom">

              <small>Website Showcase</small>

              <h3>${safeName}</h3>

            </div>

          </div>


          <div class="website-content">

            <div class="website-meta">

              <div class="website-url">
                ${safeUrl}
              </div>

              <div class="animation-label">
                ${animation}
              </div>

            </div>


            <div class="card-actions">

              <button
                class="action-btn primary explore-btn"
                data-id="${escapeAttr(site.id)}"
              >
                ✦ Explore
              </button>

              <button
                class="action-btn live-open-btn"
                data-url="${escapeAttr(site.url)}"
              >
                ↗ Live
              </button>

            </div>

          </div>
        `;


        websiteGrid.appendChild(card);

      });


      bindCardButtons();

    }


    /* =========================================================
       CARD BUTTONS
       ========================================================= */

    function bindCardButtons() {

      document
        .querySelectorAll(".explore-btn")
        .forEach(button => {

          button.addEventListener(
            "click",
            () => {

              const id =
                button.dataset.id;

              openPresentationById(id);

            }
          );

        });


      document
        .querySelectorAll(".live-open-btn")
        .forEach(button => {

          button.addEventListener(
            "click",
            () => {

              const url =
                button.dataset.url;

              if (url) {
                window.open(
                  url,
                  "_blank",
                  "noopener,noreferrer"
                );
              }

            }
          );

        });

    }


    /* =========================================================
       SEARCH
       ========================================================= */

    searchInput.addEventListener(
      "input",
      event => {

        searchTerm =
          event.target.value.trim();

        searchClear.style.display =
          searchTerm
            ? "block"
            : "none";

        renderWebsites();

      }
    );


    searchClear.addEventListener(
      "click",
      () => {

        searchInput.value = "";

        searchTerm = "";

        searchClear.style.display =
          "none";

        renderWebsites();

        searchInput.focus();

      }
    );


    /* =========================================================
       PACKAGE FILTER
       ========================================================= */

    document
      .querySelectorAll(".filter-btn")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            document
              .querySelectorAll(".filter-btn")
              .forEach(btn =>
                btn.classList.remove("active")
              );

            button.classList.add("active");

            currentFilter =
              button.dataset.filter;

            renderWebsites();

          }
        );

      });


    /* =========================================================
       THEME
       ========================================================= */

    function loadPreferences() {

      const savedTheme =
        localStorage.getItem(
          "websiteDealsTheme"
        );

      if (savedTheme === "light") {

        body.classList.add("light");

      }

      updateThemeIcon();


      const savedPin =
        localStorage.getItem(
          "websiteDealsPinned"
        );

      if (savedPin === "true") {

        enablePin(false);

      }

    }


    function updateThemeIcon() {

      themeBtn.textContent =
        body.classList.contains("light")
          ? "☀"
          : "☾";

    }


    themeBtn.addEventListener(
      "click",
      () => {

        body.classList.toggle("light");

        const isLight =
          body.classList.contains("light");

        localStorage.setItem(
          "websiteDealsTheme",
          isLight
            ? "light"
            : "dark"
        );

        updateThemeIcon();

      }
    );


    /* =========================================================
       PIN MODE
       ========================================================= */

    function enablePin(showToastMessage = true) {

      body.classList.add("pin-mode");

      pinBtn.classList.add("active");

      pinText.textContent =
        "Pinned";

      localStorage.setItem(
        "websiteDealsPinned",
        "true"
      );

      if (showToastMessage) {

        showToast(
          "📌 Marketing Wall pinned"
        );

      }

    }


    function disablePin(showToastMessage = true) {

      body.classList.remove("pin-mode");

      pinBtn.classList.remove("active");

      pinText.textContent =
        "Pin";

      localStorage.setItem(
        "websiteDealsPinned",
        "false"
      );

      if (showToastMessage) {

        showToast(
          "Pin mode off"
        );

      }

    }


    pinBtn.addEventListener(
      "click",
      () => {

        if (
          body.classList.contains(
            "pin-mode"
          )
        ) {

          disablePin();

        } else {

          enablePin();

        }

      }
    );


    /* =========================================================
       MOBILE MENU
       ========================================================= */

    mobileMenuBtn.addEventListener(
      "click",
      () => {

        navLinks.classList.toggle("open");

      }
    );


    document
      .querySelectorAll(".nav-links a")
      .forEach(link => {

        link.addEventListener(
          "click",
          () => {

            navLinks.classList.remove(
              "open"
            );

          }
        );

      });


    /* =========================================================
       CLOCK
       ========================================================= */

    function updateClock() {

      const now =
        new Date();

      clock.textContent =
        now.toLocaleTimeString(
          "en-BD",
          {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: true
          }
        );

      date.textContent =
        now.toLocaleDateString(
          "en-BD",
          {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric"
          }
        );

    }


    /* =========================================================
       SALAH REMINDER
       ========================================================= */

    const prayers = [
      {
        id: "fajr",
        name: "Fajr",
        bn: "ফজর",
        time: "04:45"
      },
      {
        id: "dhuhr",
        name: "Dhuhr",
        bn: "যোহর",
        time: "12:05"
      },
      {
        id: "asr",
        name: "Asr",
        bn: "আসর",
        time: "16:15"
      },
      {
        id: "maghrib",
        name: "Maghrib",
        bn: "মাগরিব",
        time: "18:00"
      },
      {
        id: "isha",
        name: "Isha",
        bn: "এশা",
        time: "19:20"
      }
    ];


    function updatePrayer() {

      const now =
        new Date();

      const currentMinutes =
        now.getHours() * 60 +
        now.getMinutes();


      let next = null;


      prayers.forEach(
        prayer => {

          const [hours, minutes] =
            prayer.time.split(":")
              .map(Number);

          const prayerMinutes =
            hours * 60 + minutes;

          if (
            prayerMinutes >
            currentMinutes &&
            !next
          ) {

            next = prayer;

          }

        }
      );


      document
        .querySelectorAll(".salah-item")
        .forEach(item =>
          item.classList.remove("active")
        );


      if (!next) {

        nextPrayer.textContent =
          "Fajr · 04:45";

        document
          .querySelector(
            '[data-prayer="fajr"]'
          )
          ?.classList.add("active");

        return;

      }


      nextPrayer.textContent =
        `${next.bn} · ${next.time}`;

      document
        .querySelector(
          `[data-prayer="${next.id}"]`
        )
        ?.classList.add("active");

    }


    /* =========================================================
       PRESENTATION
       ========================================================= */

    function openPresentationById(id) {

      presentationList =
        getFilteredWebsites();

      const index =
        presentationList.findIndex(
          site =>
            String(site.id) === String(id)
        );


      if (index < 0) {

        presentationList =
          websites;

        presentationIndex =
          presentationList.findIndex(
            site =>
              String(site.id) === String(id)
          );

      } else {

        presentationIndex =
          index;

      }


      if (
        presentationIndex < 0
      ) {

        presentationIndex = 0;

      }


      openPresentation();

    }


    function openPresentation() {

      if (!presentationList.length) {

        presentationList =
          websites;

      }

      const site =
        presentationList[
          presentationIndex
        ];


      if (!site) return;


      presentation.classList.add(
        "open"
      );

      presentation.classList.add(
        "active"
      );

      presentation.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.style.overflow =
        "hidden";


      presTitle.textContent =
        site.name ||
        "Website";


      presPackage.textContent =
        site.packageLabel ||
        `${site.package || ""} Package`;


      presentationFrame.src =
        site.url;


      presCounter.textContent =
        `${presentationIndex + 1} / ${presentationList.length}`;


      resetProgress();


      playBtn.textContent =
        autoPlay
          ? "Ⅱ"
          : "▶";


      if (autoPlay) {
        startAutoPlay();
      }

    }


    function closePres() {

      presentation.classList.remove(
        "active"
      );

      setTimeout(
        () => {

          presentation.classList.remove(
            "open"
          );

          presentationFrame.src =
            "about:blank";

          presentation.setAttribute(
            "aria-hidden",
            "true"
          );

        },
        300
      );


      document.body.style.overflow =
        "";

      stopAutoPlay();

    }


    closePresentation.addEventListener(
      "click",
      closePres
    );


    /* =========================================================
       NEXT / PREVIOUS
       ========================================================= */

    function nextWebsite() {

      if (!presentationList.length)
        return;

      presentationIndex =
        (
          presentationIndex + 1
        ) %
        presentationList.length;

      openPresentation();

      playSound("next");

    }


    function previousWebsite() {

      if (!presentationList.length)
        return;

      presentationIndex =
        (
          presentationIndex -
          1 +
          presentationList.length
        ) %
        presentationList.length;

      openPresentation();

      playSound("next");

    }


    nextBtn.addEventListener(
      "click",
      nextWebsite
    );


    prevBtn.addEventListener(
      "click",
      previousWebsite
    );


    /* =========================================================
       LIVE OPEN
       ========================================================= */

    liveBtn.addEventListener(
      "click",
      () => {

        const site =
          presentationList[
            presentationIndex
          ];

        if (
          site &&
          site.url
        ) {

          window.open(
            site.url,
            "_blank",
            "noopener,noreferrer"
          );

        }

      }
    );


    /* =========================================================
       AUTOPLAY
       ========================================================= */

    function startAutoPlay() {

      stopAutoPlay();

      autoPlay = true;

      autoBtn.textContent =
        "Ⅱ";

      playBtn.textContent =
        "Ⅱ";


      progressStart =
        Date.now();


      progressTimer =
        setInterval(
          updateProgress,
          40
        );


      autoTimer =
        setTimeout(
          () => {

            nextWebsite();

          },
          AUTO_DURATION
        );

    }


    function stopAutoPlay() {

      clearTimeout(
        autoTimer
      );

      clearInterval(
        progressTimer
      );

      autoTimer = null;
      progressTimer = null;

      progress.style.width =
        "0%";

    }


    function toggleAutoPlay() {

      autoPlay =
        !autoPlay;

      if (autoPlay) {

        startAutoPlay();

        showToast(
          "▶ Auto Play ON"
        );

      } else {

        stopAutoPlay();

        autoBtn.textContent =
          "▶";

        playBtn.textContent =
          "▶";

        showToast(
          "Ⅱ Auto Play OFF"
        );

      }

    }


    autoBtn.addEventListener(
      "click",
      toggleAutoPlay
    );


    playBtn.addEventListener(
      "click",
      toggleAutoPlay
    );


    function resetProgress() {

      progress.style.width =
        "0%";

      if (autoPlay) {

        startAutoPlay();

      }

    }


    function updateProgress() {

      const elapsed =
        Date.now() -
        progressStart;

      const percent =
        Math.min(
          100,
          (elapsed /
            AUTO_DURATION) *
          100
        );

      progress.style.width =
        percent + "%";

    }


    /* =========================================================
       FULLSCREEN
       ========================================================= */

    fullscreenBtn.addEventListener(
      "click",
      async () => {

        try {

          if (
            !document.fullscreenElement
          ) {

            await presentation.requestFullscreen();

          } else {

            await document.exitFullscreen();

          }

        } catch (error) {

          showToast(
            "Fullscreen unavailable"
          );

        }

      }
    );


    /* =========================================================
       SOUND
       ========================================================= */

    let audioContext = null;


    function playSound(type = "click") {

      if (!soundEnabled)
        return;


      try {

        if (!audioContext) {

          audioContext =
            new (
              window.AudioContext ||
              window.webkitAudioContext
            )();

        }


        const oscillator =
          audioContext.createOscillator();

        const gain =
          audioContext.createGain();


        oscillator.connect(
          gain
        );

        gain.connect(
          audioContext.destination
        );


        oscillator.type =
          "sine";


        oscillator.frequency.value =
          type === "next"
            ? 680
            : 520;


        gain.gain.setValueAtTime(
          0.0001,
          audioContext.currentTime
        );

        gain.gain.exponentialRampToValueAtTime(
          0.035,
          audioContext.currentTime + .01
        );

        gain.gain.exponentialRampToValueAtTime(
          0.0001,
          audioContext.currentTime + .15
        );


        oscillator.start();

        oscillator.stop(
          audioContext.currentTime + .16
        );

      } catch (error) {

        console.warn(
          "Sound unavailable."
        );

      }

    }


    soundBtn.addEventListener(
      "click",
      () => {

        soundEnabled =
          !soundEnabled;

        soundBtn.textContent =
          soundEnabled
            ? "🔊"
            : "🔇";

        if (soundEnabled) {

          playSound();

          showToast(
            "🔊 Presentation sound ON"
          );

        } else {

          showToast(
            "🔇 Presentation sound OFF"
          );

        }

      }
    );


    /* =========================================================
       KEYBOARD CONTROLS
       ========================================================= */

    document.addEventListener(
      "keydown",
      event => {

        if (
          !presentation.classList.contains(
            "open"
          )
        ) {

          return;

        }


        if (
          event.key === "Escape"
        ) {

          closePres();

        }


        if (
          event.key === "ArrowRight"
        ) {

          nextWebsite();

        }


        if (
          event.key === "ArrowLeft"
        ) {

          previousWebsite();

        }


        if (
          event.key.toLowerCase() === "f"
        ) {

          fullscreenBtn.click();

        }


        if (
          event.key.toLowerCase() === "s"
        ) {

          soundBtn.click();

        }


        if (
          event.code === "Space"
        ) {

          event.preventDefault();

          toggleAutoPlay();

        }

      }
    );


    /* =========================================================
       TOUCH SWIPE
       ========================================================= */

    let touchStartX = 0;


    presentation.addEventListener(
      "touchstart",
      event => {

        touchStartX =
          event.changedTouches[0].screenX;

      },
      { passive: true }
    );


    presentation.addEventListener(
      "touchend",
      event => {

        const touchEndX =
          event.changedTouches[0].screenX;

        const difference =
          touchEndX -
          touchStartX;


        if (
          Math.abs(difference) < 60
        ) {

          return;

        }


        if (difference < 0) {

          nextWebsite();

        } else {

          previousWebsite();

        }

      },
      { passive: true }
    );


    /* =========================================================
       TOAST
       ========================================================= */

    let toastTimer = null;


    function showToast(message) {

      toast.textContent =
        message;

      toast.classList.add(
        "show"
      );


      clearTimeout(
        toastTimer
      );


      toastTimer =
        setTimeout(
          () => {

            toast.classList.remove(
              "show"
            );

          },
          2200
        );

    }


    /* =========================================================
       SAFE HTML
       ========================================================= */

    function escapeHTML(value) {

      return String(
        value ?? ""
      )
        .replaceAll(
          "&",
          "&amp;"
        )
        .replaceAll(
          "<",
          "&lt;"
        )
        .replaceAll(
          ">",
          "&gt;"
        )
        .replaceAll(
          '"',
          "&quot;"
        )
        .replaceAll(
          "'",
          "&#039;"
        );

    }


    function escapeAttr(value) {

      return escapeHTML(
        value
      );

    }


    /* =========================================================
       START
       ========================================================= */

    init();

  </script>

</body>
</html>
