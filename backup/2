<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Website Deals | Live Marketing Wall</title>

  <meta
    name="description"
    content="Website Deals — Your live website marketing wall. Explore premium ready-made websites anywhere."
  >

  <meta name="theme-color" content="#080909">

  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    /* =========================================================
       WEBSITE DEALS
       LIVE MARKETING WALL
       package/index.html
       ========================================================= */

    :root {
      --bg: #080909;
      --bg-soft: #0d0f0f;
      --card: rgba(18, 21, 20, 0.86);
      --card-strong: #111414;
      --text: #f5f7f6;
      --muted: #98a29e;
      --line: rgba(255,255,255,.09);
      --lime: #b7ff00;
      --lime-soft: rgba(183,255,0,.10);
      --lime-border: rgba(183,255,0,.24);
      --danger: #ff5c67;
      --warning: #ffca4d;
      --shadow: 0 24px 80px rgba(0,0,0,.35);
      --radius-xl: 28px;
      --radius-lg: 20px;
      --radius-md: 14px;
      --nav-height: 76px;
    }

    body.light {
      --bg: #f4f6f3;
      --bg-soft: #ffffff;
      --card: rgba(255,255,255,.90);
      --card-strong: #ffffff;
      --text: #101412;
      --muted: #68716d;
      --line: rgba(16,20,18,.10);
      --lime: #72a900;
      --lime-soft: rgba(114,169,0,.10);
      --lime-border: rgba(114,169,0,.25);
      --shadow: 0 24px 70px rgba(28,38,31,.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 10% 0%, rgba(183,255,0,.08), transparent 26%),
        radial-gradient(circle at 90% 15%, rgba(0,255,180,.045), transparent 24%),
        var(--bg);
      color: var(--text);
      font-family: "Inter", "Hind Siliguri", sans-serif;
      overflow-x: hidden;
      transition:
        background .35s ease,
        color .35s ease;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: .28;
      z-index: -1;
      background-image:
        linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(to bottom, black, transparent 85%);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    /* =========================================================
       NAVBAR
       ========================================================= */

    .navbar {
      position: sticky;
      top: 0;
      z-index: 1000;
      height: var(--nav-height);
      border-bottom: 1px solid var(--line);
      background: color-mix(in srgb, var(--bg) 86%, transparent);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }

    .nav-inner {
      width: min(1440px, calc(100% - 32px));
      height: 100%;
      margin: auto;
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: max-content;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: var(--lime);
      color: #080909;
      font-weight: 900;
      box-shadow: 0 0 28px rgba(183,255,0,.16);
    }

    .brand-copy strong {
      display: block;
      font-family: "Space Grotesk", sans-serif;
      font-size: 16px;
      line-height: 1;
      letter-spacing: -.03em;
    }

    .brand-copy span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      margin-top: 4px;
      text-transform: uppercase;
      letter-spacing: .12em;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-left: 10px;
    }

    .nav-links a {
      padding: 10px 12px;
      border-radius: 10px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
      transition: .2s ease;
    }

    .nav-links a:hover {
      color: var(--text);
      background: var(--lime-soft);
    }

    .nav-spacer {
      flex: 1;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .icon-btn,
    .pin-btn {
      height: 42px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--text);
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: .2s ease;
    }

    .icon-btn {
      width: 42px;
    }

    .pin-btn {
      gap: 7px;
      padding: 0 13px;
      font-size: 12px;
      font-weight: 700;
    }

    .icon-btn:hover,
    .pin-btn:hover {
      border-color: var(--lime-border);
      transform: translateY(-1px);
    }

    .pin-btn.active {
      background: var(--lime);
      color: #080909;
      border-color: var(--lime);
      box-shadow: 0 0 24px rgba(183,255,0,.18);
    }

    .mobile-menu-btn {
      display: none;
    }

    /* =========================================================
       HERO
       ========================================================= */

    .hero {
      width: min(1440px, calc(100% - 32px));
      margin: 0 auto;
      padding: 68px 0 30px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 30px;
      align-items: end;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--lime);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .15em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--lime);
      box-shadow: 0 0 15px var(--lime);
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%,100% {
        opacity: 1;
        transform: scale(1);
      }
      50% {
        opacity: .35;
        transform: scale(.72);
      }
    }

    .hero h1 {
      max-width: 800px;
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(44px, 6vw, 86px);
      line-height: .94;
      letter-spacing: -.065em;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: var(--lime);
    }

    .hero p {
      max-width: 650px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.8;
    }

    .hero-side {
      border: 1px solid var(--line);
      background: linear-gradient(
        145deg,
        rgba(255,255,255,.035),
        rgba(255,255,255,.012)
      );
      border-radius: var(--radius-xl);
      padding: 22px;
      box-shadow: var(--shadow);
    }

    .wall-status {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 18px;
    }

    .status-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .status-icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: var(--lime-soft);
      color: var(--lime);
    }

    .status-copy strong {
      display: block;
      font-size: 13px;
    }

    .status-copy span {
      color: var(--muted);
      font-size: 11px;
    }

    .status-pill {
      padding: 7px 10px;
      border-radius: 999px;
      background: var(--lime-soft);
      color: var(--lime);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .clock {
      font-family: "Space Grotesk", sans-serif;
      font-size: 31px;
      font-weight: 700;
      letter-spacing: -.04em;
    }

    .date {
      color: var(--muted);
      font-size: 11px;
      margin-top: 3px;
    }

    /* =========================================================
       SEARCH / CONTROL BAR
       ========================================================= */

    .control-wrap {
      width: min(1440px, calc(100% - 32px));
      margin: 10px auto 0;
    }

    .control-bar {
      display: flex;
      gap: 10px;
      align-items: center;
      padding: 10px;
      border: 1px solid var(--line);
      background: var(--card);
      border-radius: 18px;
      box-shadow: var(--shadow);
    }

    .search-box {
      position: relative;
      flex: 1;
    }

    .search-box span {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: 16px;
    }

    .search-box input {
      width: 100%;
      height: 46px;
      padding: 0 42px;
      border: 1px solid transparent;
      outline: none;
      border-radius: 12px;
      background: var(--bg-soft);
      color: var(--text);
    }

    .search-box input:focus {
      border-color: var(--lime-border);
    }

    .search-clear {
      position: absolute;
      right: 8px;
      top: 7px;
      width: 32px;
      height: 32px;
      border: 0;
      background: transparent;
      color: var(--muted);
      border-radius: 8px;
      display: none;
    }

    .filter-group {
      display: flex;
      gap: 5px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .filter-group::-webkit-scrollbar {
      display: none;
    }

    .filter-btn {
      border: 1px solid transparent;
      background: transparent;
      color: var(--muted);
      padding: 11px 13px;
      border-radius: 10px;
      white-space: nowrap;
      font-size: 12px;
      font-weight: 700;
    }

    .filter-btn:hover,
    .filter-btn.active {
      color: var(--text);
      background: var(--lime-soft);
      border-color: var(--lime-border);
    }

    /* =========================================================
       SALAH REMINDER
       ========================================================= */

    .salah-section {
      width: min(1440px, calc(100% - 32px));
      margin: 22px auto 0;
    }

    .salah-card {
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      background:
        radial-gradient(circle at 90% 20%, rgba(183,255,0,.09), transparent 30%),
        var(--card);
      overflow: hidden;
    }

    .salah-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 20px;
      border-bottom: 1px solid var(--line);
    }

    .salah-title {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .salah-title-icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: var(--lime-soft);
      color: var(--lime);
      font-size: 18px;
    }

    .salah-title strong {
      display: block;
      font-family: "Hind Siliguri", sans-serif;
      font-size: 15px;
    }

    .salah-title span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      margin-top: 1px;
    }

    .next-prayer {
      text-align: right;
    }

    .next-prayer small {
      color: var(--muted);
      display: block;
      font-size: 10px;
    }

    .next-prayer strong {
      color: var(--lime);
      font-size: 14px;
    }

    .salah-list {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
    }

    .salah-item {
      padding: 16px 14px;
      text-align: center;
      border-right: 1px solid var(--line);
      transition: .2s ease;
    }

    .salah-item:last-child {
      border-right: 0;
    }

    .salah-item.active {
      background: var(--lime-soft);
      box-shadow: inset 0 -2px 0 var(--lime);
    }

    .salah-item .arabic {
      font-family: "Hind Siliguri", sans-serif;
      font-size: 12px;
      color: var(--muted);
    }

    .salah-item .name {
      display: block;
      font-size: 12px;
      font-weight: 800;
      margin: 4px 0;
    }

    .salah-item .time {
      color: var(--lime);
      font-family: "Space Grotesk", sans-serif;
      font-size: 14px;
      font-weight: 700;
    }

    .salah-note {
      padding: 11px 18px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-family: "Hind Siliguri", sans-serif;
      font-size: 11px;
      text-align: center;
    }

    /* =========================================================
       SHOWCASE
       ========================================================= */

    .showcase-section {
      width: min(1440px, calc(100% - 32px));
      margin: 42px auto 80px;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 20px;
    }

    .section-heading h2 {
      font-family: "Space Grotesk", sans-serif;
      font-size: 30px;
      letter-spacing: -.045em;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 12px;
      margin-top: 5px;
    }

    .website-count {
      color: var(--muted);
      font-size: 11px;
    }

    .website-count strong {
      color: var(--lime);
    }

    .website-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .website-card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--line);
      background: var(--card);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow);
      transition:
        transform .3s ease,
        border-color .3s ease;
    }

    .website-card:hover {
      transform: translateY(-5px);
      border-color: var(--lime-border);
    }

    .preview {
      position: relative;
      height: 270px;
      overflow: hidden;
      background: #060707;
    }

    .preview iframe {
      position: absolute;
      width: 144%;
      height: 144%;
      left: -22%;
      top: -3%;
      border: 0;
      transform: scale(.72);
      transform-origin: top center;
      pointer-events: none;
      background: white;
    }

    .preview-shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        transparent 45%,
        rgba(0,0,0,.7)
      );
      pointer-events: none;
    }

    .preview-top {
      position: absolute;
      left: 14px;
      right: 14px;
      top: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 2;
    }

    .package-badge,
    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 9px;
      border-radius: 8px;
      backdrop-filter: blur(12px);
      background: rgba(0,0,0,.45);
      border: 1px solid rgba(255,255,255,.12);
      color: #fff;
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .live-badge {
      color: var(--lime);
    }

    .live-badge i {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--lime);
      box-shadow: 0 0 9px var(--lime);
    }

    .preview-bottom {
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 17px;
      z-index: 3;
      color: white;
    }

    .preview-bottom small {
      opacity: .7;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .preview-bottom h3 {
      margin-top: 4px;
      font-size: 20px;
      letter-spacing: -.035em;
    }

    .website-content {
      padding: 17px;
    }

    .website-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 13px;
    }

    .website-url {
      color: var(--muted);
      font-size: 10px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .animation-label {
      color: var(--lime);
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .card-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .action-btn {
      height: 42px;
      border-radius: 11px;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--text);
      font-size: 11px;
      font-weight: 800;
      transition: .2s ease;
    }

    .action-btn:hover {
      border-color: var(--lime-border);
      background: var(--lime-soft);
    }

    .action-btn.primary {
      border-color: var(--lime);
      background: var(--lime);
      color: #080909;
    }

    .action-btn.primary:hover {
      box-shadow: 0 8px 24px rgba(183,255,0,.18);
      transform: translateY(-1px);
    }

    .empty-state {
      display: none;
      text-align: center;
      padding: 70px 20px;
      border: 1px dashed var(--line);
      border-radius: var(--radius-xl);
      color: var(--muted);
    }

    .empty-state.show {
      display: block;
    }

    .empty-state strong {
      display: block;
      color: var(--text);
      font-size: 18px;
      margin-bottom: 7px;
    }

    /* =========================================================
       FOOTER
       ========================================================= */

    footer {
      width: min(1440px, calc(100% - 32px));
      margin: 0 auto;
      padding: 22px 0 35px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 10px;
      display: flex;
      justify-content: space-between;
      gap: 15px;
    }

    /* =========================================================
       PRESENTATION MODAL
       ========================================================= */

    .presentation {
      position: fixed;
      inset: 0;
      z-index: 3000;
      display: none;
      background: #030404;
    }

    .presentation.open {
      display: block;
    }

    .presentation-ui {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 14px;
      background: linear-gradient(to bottom, rgba(0,0,0,.8), transparent);
      pointer-events: none;
    }

    .presentation-ui > * {
      pointer-events: auto;
    }

    .presentation-title {
      flex: 1;
      min-width: 0;
    }

    .presentation-title strong {
      display: block;
      color: white;
      font-size: 13px;
    }

    .presentation-title span {
      color: rgba(255,255,255,.5);
      font-size: 9px;
    }

    .pres-btn {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.4);
      color: white;
      backdrop-filter: blur(12px);
    }

    .pres-btn:hover {
      background: rgba(255,255,255,.1);
    }

    .presentation-stage {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      overflow: hidden;
      perspective: 1200px;
    }

    .device {
      position: relative;
      width: min(1100px, 86vw);
      height: min(690px, 74vh);
      padding: 14px;
      border-radius: 26px;
      background: linear-gradient(145deg, #252928, #080909);
      box-shadow:
        0 60px 120px rgba(0,0,0,.55),
        0 0 0 1px rgba(255,255,255,.07);
      transform:
        translateY(10px)
        scale(.96);
      transition:
        transform .75s cubic-bezier(.16,1,.3,1),
        opacity .55s ease;
      opacity: 0;
    }

    .presentation.active .device {
      transform:
        translateY(0)
        scale(1);
      opacity: 1;
    }

    .device-camera {
      position: absolute;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #050505;
      top: 5px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
    }

    .device-screen {
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 17px;
      background: white;
      position: relative;
    }

    .device-screen iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
      background: white;
    }

    .device-base {
      position: absolute;
      width: 26%;
      height: 7px;
      bottom: -11px;
      left: 37%;
      border-radius: 0 0 10px 10px;
      background: #161818;
    }

    .pres-controls {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: 22px;
      z-index: 7;
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 7px;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 15px;
      background: rgba(0,0,0,.58);
      backdrop-filter: blur(20px);
    }

    .pres-control {
      width: 39px;
      height: 39px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: white;
    }

    .pres-control:hover {
      background: rgba(255,255,255,.1);
    }

    .pres-control.main {
      background: var(--lime);
      color: #080909;
    }

    .progress-wrap {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 3px;
      background: rgba(255,255,255,.08);
      z-index: 10;
    }

