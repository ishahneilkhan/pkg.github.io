<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#080909" />
  <meta
    name="description"
    content="Website Deals — Premium ready-made websites, live website showcase and monthly website packages."
  />

  <title>Website Deals | Premium Website Marketplace</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --bg: #080909;
      --bg-soft: #0d0f10;
      --card: #111415;
      --card-2: #151819;
      --text: #f5f7f7;
      --muted: #929a9a;
      --line: rgba(255,255,255,.09);
      --accent: #b7ff00;
      --accent-dark: #8fc900;
      --danger: #ff5d6c;
      --shadow: 0 24px 70px rgba(0,0,0,.38);
      --radius: 24px;
    }

    body.light {
      --bg: #f5f7f6;
      --bg-soft: #ffffff;
      --card: #ffffff;
      --card-2: #f1f4f2;
      --text: #101414;
      --muted: #687171;
      --line: rgba(0,0,0,.09);
      --shadow: 0 20px 60px rgba(0,0,0,.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 10% 0%, rgba(183,255,0,.08), transparent 30%),
        radial-gradient(circle at 90% 15%, rgba(183,255,0,.05), transparent 28%),
        var(--bg);
      color: var(--text);
      font-family: Inter, "Hind Siliguri", sans-serif;
      overflow-x: hidden;
      transition: background .3s ease, color .3s ease;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    /* =========================
       TOP SALAH BAR
    ========================== */

    .salah-bar {
      width: 100%;
      border-bottom: 1px solid var(--line);
      background: rgba(8,9,9,.76);
      backdrop-filter: blur(18px);
      position: relative;
      z-index: 1000;
    }

    body.light .salah-bar {
      background: rgba(255,255,255,.78);
    }

    .salah-inner {
      width: min(1180px, calc(100% - 32px));
      min-height: 38px;
      margin: auto;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .salah-inner::-webkit-scrollbar {
      display: none;
    }

    .salah-item {
      white-space: nowrap;
      font-size: 11px;
      color: var(--muted);
    }

    .salah-item strong {
      color: var(--text);
      margin-right: 4px;
    }

    /* =========================
       NAVBAR
    ========================== */

    .navbar {
      position: sticky;
      top: 0;
      z-index: 900;
      border-bottom: 1px solid var(--line);
      background: rgba(8,9,9,.74);
      backdrop-filter: blur(22px);
    }

    body.light .navbar {
      background: rgba(255,255,255,.78);
    }

    .nav-inner {
      width: min(1180px, calc(100% - 32px));
      min-height: 72px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      flex-shrink: 0;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: var(--accent);
      color: #080909;
      font-weight: 900;
      box-shadow: 0 0 35px rgba(183,255,0,.18);
    }

    .brand-name {
      font-family: "Space Grotesk", sans-serif;
      font-weight: 700;
      letter-spacing: -.4px;
    }

    .brand-name span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-links a {
      padding: 10px 13px;
      border-radius: 10px;
      font-size: 13px;
      color: var(--muted);
      transition: .2s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--text);
      background: var(--card);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--card);
      color: var(--text);
      cursor: pointer;
      transition: .2s ease;
    }

    .icon-btn:hover {
      border-color: rgba(183,255,0,.45);
      transform: translateY(-1px);
    }

    .mobile-menu-btn {
      display: none;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      width: min(1180px, calc(100% - 32px));
      min-height: 650px;
      margin: auto;
      display: grid;
      place-items: center;
      text-align: center;
      position: relative;
      padding: 100px 0 80px;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: rgba(183,255,0,.07);
      filter: blur(80px);
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      max-width: 850px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(183,255,0,.22);
      border-radius: 999px;
      color: var(--accent);
      background: rgba(183,255,0,.05);
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 22px;
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 14px var(--accent);
    }

    .hero h1 {
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(46px, 8vw, 92px);
      line-height: .94;
      letter-spacing: -5px;
      margin-bottom: 25px;
    }

    .hero h1 span {
      color: var(--accent);
    }

    .hero p {
      max-width: 680px;
      margin: auto;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.8;
    }

    .hero-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 34px;
    }

    .btn {
      min-height: 48px;
      padding: 0 19px;
      border-radius: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 1px solid var(--line);
      cursor: pointer;
      transition: .25s ease;
      font-weight: 700;
      font-size: 13px;
    }

    .btn-primary {
      background: var(--accent);
      color: #080909;
      border-color: var(--accent);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 40px rgba(183,255,0,.16);
    }

    .btn-secondary {
      background: var(--card);
      color: var(--text);
    }

    .btn-secondary:hover {
      border-color: rgba(183,255,0,.35);
    }

    /* =========================
       SECTION
    ========================== */

    .section {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
      padding: 100px 0;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 30px;
      margin-bottom: 34px;
    }

    .section-kicker {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 11px;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .section h2 {
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(30px, 5vw, 54px);
      letter-spacing: -2px;
    }

    .section-desc {
      max-width: 500px;
      color: var(--muted);
      line-height: 1.75;
      font-size: 14px;
    }

    /* =========================
       PACKAGE CARDS
    ========================== */

    .package-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .package-card {
      position: relative;
      padding: 28px;
      min-height: 470px;
      background:
        linear-gradient(145deg, rgba(255,255,255,.035), transparent 45%),
        var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
      transition: .3s ease;
    }

    .package-card:hover {
      transform: translateY(-7px);
      border-color: rgba(183,255,0,.30);
    }

    .package-card.featured {
      border-color: rgba(183,255,0,.4);
      box-shadow: 0 25px 80px rgba(183,255,0,.08);
    }

    .popular {
      position: absolute;
      top: 18px;
      right: 18px;
      padding: 6px 9px;
      border-radius: 999px;
      background: var(--accent);
      color: #080909;
      font-size: 9px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .package-name {
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--muted);
    }

    .price {
      margin: 16px 0 5px;
      font-family: "Space Grotesk", sans-serif;
      font-size: 48px;
      font-weight: 700;
      letter-spacing: -3px;
    }

    .price small {
      font-size: 14px;
      color: var(--muted);
      letter-spacing: 0;
    }

    .package-desc {
      min-height: 52px;
      color: var(--muted);
      line-height: 1.65;
      font-size: 13px;
    }

    .features {
      list-style: none;
      margin: 25px 0;
      display: grid;
      gap: 11px;
    }

    .features li {
      display: flex;
      gap: 9px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }

    .features li::before {
      content: "✓";
      color: var(--accent);
      font-weight: 900;
    }

    .package-card .btn {
      width: 100%;
      position: absolute;
      left: 28px;
      right: 28px;
      bottom: 28px;
      width: calc(100% - 56px);
    }

    /* =========================
       LIVE WEBSITES
    ========================== */

    .websites-section {
      position: relative;
    }

    .showcase-note {
      padding: 14px 16px;
      margin-bottom: 24px;
      border: 1px solid rgba(183,255,0,.15);
      border-radius: 14px;
      background: rgba(183,255,0,.035);
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
    }

    .showcase-note strong {
      color: var(--accent);
    }

    /*
      IMPORTANT:
      Cards remain FIXED.
      Only the tall iframe camera moves inside .preview-viewport.
    */

    .website-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .website-card {
      min-width: 0;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 22px;
      overflow: hidden;
      box-shadow: var(--shadow);
      transition: border-color .25s ease, transform .25s ease;
    }

    .website-card:hover {
      border-color: rgba(183,255,0,.28);
      transform: translateY(-4px);
    }

    .website-top {
      padding: 18px 18px 15px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .website-info {
      min-width: 0;
    }

    .website-name {
      font-size: 14px;
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .website-package {
      margin-top: 5px;
      color: var(--muted);
      font-size: 10px;
    }

    .live-badge {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 8px;
      border: 1px solid rgba(183,255,0,.18);
      background: rgba(183,255,0,.05);
      border-radius: 999px;
      color: var(--accent);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: .7px;
    }

    .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 9px var(--accent);
      animation: livePulse 1.6s infinite;
    }

    @keyframes livePulse {
      50% {
        opacity: .35;
        transform: scale(.7);
      }
    }

    /* Preview camera */

    .preview-viewport {
      height: 410px;
      position: relative;
      margin: 0 14px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: #fff;
      isolation: isolate;
    }

    .preview-camera {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      transform: translate3d(0, 0, 0);
      will-change: transform;
    }

    .preview-frame {
      display: block;
      width: 100%;
      height: 1800px;
      border: 0;
      background: #fff;
      pointer-events: none;
    }

    /*
      Fake human mouse cursor.
      This moves over the website preview, not the user's real cursor.
    */

    .human-cursor {
      position: absolute;
      z-index: 20;
      width: 17px;
      height: 24px;
      pointer-events: none;
      opacity: 0;
      filter: drop-shadow(0 2px 3px rgba(0,0,0,.45));
      transition:
        left 1.1s cubic-bezier(.22,.61,.36,1),
        top 1.1s cubic-bezier(.22,.61,.36,1),
        opacity .35s ease;
    }

    .human-cursor::before {
      content: "";
      position: absolute;
      left: 1px;
      top: 0;
      width: 0;
      height: 0;
      border-top: 22px solid #111;
      border-right: 11px solid transparent;
    }

    .human-cursor::after {
      content: "";
      position: absolute;
      left: 3px;
      top: 2px;
      width: 0;
      height: 0;
      border-top: 18px solid #fff;
      border-right: 9px solid transparent;
    }

    .scroll-hint {
      position: absolute;
      z-index: 25;
      left: 50%;
      bottom: 13px;
      transform: translateX(-50%);
      padding: 6px 9px;
      border-radius: 999px;
      background: rgba(0,0,0,.72);
      color: #fff;
      font-size: 8px;
      letter-spacing: .8px;
      font-weight: 800;
      opacity: .75;
      pointer-events: none;
    }

    .website-bottom {
      padding: 15px 18px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .status-text {
      color: var(--muted);
      font-size: 10px;
    }

    .website-actions {
      display: flex;
      gap: 7px;
    }

    .mini-btn {
      height: 34px;
      padding: 0 11px;
      border-radius: 9px;
      border: 1px solid var(--line);
      background: var(--card-2);
      color: var(--text);
      cursor: pointer;
      font-size: 10px;
      font-weight: 800;
      transition: .2s ease;
    }

    .mini-btn:hover {
      border-color: rgba(183,255,0,.35);
    }

    .mini-btn.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #080909;
    }

    /* =========================
       ABOUT / MARKETING WALL
    ========================== */

    .about-box {
      padding: 55px;
      border: 1px solid var(--line);
      border-radius: 30px;
      background:
        radial-gradient(circle at 90% 10%, rgba(183,255,0,.08), transparent 30%),
        var(--card);
    }

    .about-box h2 {
      max-width: 750px;
      margin-bottom: 20px;
    }

    .about-box p {
      max-width: 720px;
      color: var(--muted);
      line-height: 1.9;
      font-size: 14px;
    }

    .wall-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 35px;
    }

    .stat {
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--bg-soft);
    }

    .stat strong {
      display: block;
      font-family: "Space Grotesk", sans-serif;
      font-size: 28px;
      margin-bottom: 5px;
    }

    .stat span {
      color: var(--muted);
      font-size: 10px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      border-top: 1px solid var(--line);
      padding: 40px 0;
    }

    .footer-inner {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
      display: flex;
      justify-content: space-between;
      gap: 30px;
      color: var(--muted);
      font-size: 11px;
    }

    .footer-links {
      display: flex;
      gap: 18px;
    }

    .footer-links a:hover {
      color: var(--accent);
    }

    /* =========================
       PRESENTATION MODAL
    ========================== */

    .modal {
      position: fixed;
      inset: 0;
      z-index: 5000;
      display: none;
      padding: 22px;
      background: rgba(0,0,0,.82);
      backdrop-filter: blur(18px);
    }

    .modal.show {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-box {
      width: min(1300px, 100%);
      height: min(90vh, 900px);
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 30px 100px rgba(0,0,0,.6);
      display: flex;
      flex-direction: column;
    }

    .modal-head {
      min-height: 60px;
      padding: 10px 14px 10px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      border-bottom: 1px solid var(--line);
    }

    .modal-title {
      font-size: 13px;
      font-weight: 800;
    }

    .modal-actions {
      display: flex;
      gap: 7px;
    }

    .modal-frame {
      flex: 1;
      border: 0;
      width: 100%;
      background: #fff;
    }

    /* =========================
       LOADING
    ========================== */

    .loader {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      z-index: 10;
      background: #fff;
    }

    .loader-ring {
      width: 30px;
      height: 30px;
      border: 3px solid #ddd;
      border-top-color: #111;
      border-radius: 50%;
      animation: spin .8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* =========================
       RESPONSIVE
    ========================== */

    @media (max-width: 1000px) {
      .nav-links {
        display: none;
      }

      .mobile-menu-btn {
        display: block;
      }

      .package-grid,
      .website-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .wall-stats {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 680px) {
      .salah-inner {
        justify-content: flex-start;
      }

      .nav-inner {
        min-height: 64px;
      }

      .brand-name {
        font-size: 13px;
      }

      .hero {
        min-height: 570px;
        padding: 70px 0;
      }

      .hero h1 {
        letter-spacing: -3px;
        font-size: clamp(42px, 14vw, 65px);
      }

      .hero p {
        font-size: 14px;
      }

      .section {
        padding: 70px 0;
      }

      .section-head {
        display: block;
      }

      .section-desc {
        margin-top: 15px;
      }

      .package-grid,
      .website-grid {
        grid-template-columns: 1fr;
      }

      .about-box {
        padding: 30px 22px;
      }

      .wall-stats {
        grid-template-columns: 1fr 1fr;
      }

      .footer-inner {
        display: block;
      }

      .footer-links {
        margin-top: 18px;
        flex-wrap: wrap;
      }

      .preview-viewport {
        height: 380px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- =========================
       SALAH
  ========================== -->

  <div class="salah-bar">
    <div class="salah-inner">
      <div class="salah-item"><strong>Fajr</strong>04:45</div>
      <div class="salah-item"><strong>Dhuhr</strong>12:05</div>
      <div class="salah-item"><strong>Asr</strong>16:15</div>
      <div class="salah-item"><strong>Maghrib</strong>18:00</div>
      <div class="salah-item"><strong>Isha</strong>19:20</div>
    </div>
  </div>

  <!-- =========================
       NAVBAR
  ========================== -->

  <header class="navbar">
    <div class="nav-inner">

      <a href="#home" class="brand">
        <div class="brand-mark">WD</div>
        <div class="brand-name">Website<span>Deals</span></div>
      </a>

      <nav class="nav-links">
        <a href="#home" class="active">Home</a>
        <a href="#package">Package</a>
        <a href="#websites">Websites</a>
        <a href="#salah">Salah</a>
        <a href="#about">About</a>
        <a href="https://support.websitedeals.com" target="_blank" rel="noopener">Support</a>
      </nav>

      <div class="nav-actions">
        <button class="icon-btn mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Menu">
          ☰
        </button>

        <button class="icon-btn" onclick="toggleTheme()" aria-label="Toggle theme">
          ◐
        </button>
      </div>

    </div>
  </header>

  <!-- =========================
       HERO
  ========================== -->

  <main id="home">

    <section class="hero">
      <div class="hero-content">

        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
