  <!-- =========================
       PRESENTATION MODAL
  ========================== -->

  <div class="modal" id="presentationModal">

    <div class="modal-box">

      <div class="modal-head">

        <div class="modal-title" id="modalTitle">
          Live Website Presentation
        </div>

        <div class="modal-actions">

          <button class="mini-btn" onclick="openCurrentWebsite()">
            Open Live ↗
          </button>

          <button class="mini-btn" onclick="closePresentation()">
            Close
          </button>

        </div>

      </div>

      <iframe
        class="modal-frame"
        id="modalFrame"
        title="Live Website Presentation"
      ></iframe>

    </div>

