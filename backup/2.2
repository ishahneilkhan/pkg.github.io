  <script>
    /* =========================================================
       WEBSITE DATA
       Admin will later control this list through:
       package/admin/websites.html
    ========================================================= */

    const defaultWebsites = [
      {
        id: "snk-it-institute",
        name: "SNK IT Institute",
        package: "business",
        packageLabel: "Business Package",
        url: "https://snkitinstitute.com",
        status: true,
        sort: 1
      },
      {
        id: "website-deals-demo",
        name: "Website Deals",
        package: "premium",
        packageLabel: "Premium Package",
        url: "https://websitedeals.com",
        status: true,
        sort: 2
      }
    ];

    const STORAGE_KEY = "websiteDealsWebsites";

    let websites = [];
    let currentWebsiteUrl = "";

    /* =========================================================
       LOAD WEBSITE DATA
    ========================================================= */

    function loadWebsites() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);

        if (saved) {
          const parsed = JSON.parse(saved);

          if (Array.isArray(parsed) && parsed.length) {
            websites = parsed
              .filter(site => site.status !== false)
              .sort((a, b) => Number(a.sort || 0) - Number(b.sort || 0));
          } else {
            websites = defaultWebsites;
          }
        } else {
          websites = defaultWebsites;
        }

      } catch (error) {
        console.warn("Website data could not be loaded.", error);
        websites = defaultWebsites;
      }

      renderWebsites();
    }

    /* =========================================================
       CREATE WEBSITE CARD
    ========================================================= */

    function renderWebsites() {

      const grid = document.getElementById("websiteGrid");

      if (!grid) return;

      if (!websites.length) {
        grid.innerHTML = `
          <div style="
            grid-column:1/-1;
            padding:50px;
            border:1px solid var(--line);
            border-radius:20px;
            text-align:center;
            color:var(--muted);
          ">
            No live websites available yet.
          </div>
        `;

        return;
      }

      grid.innerHTML = websites.map((site, index) => {

        const packageName =
          site.packageLabel ||
          `${capitalize(site.package || "Website")} Package`;

        return `
          <article class="website-card">

            <div class="website-top">

              <div class="website-info">
                <div class="website-name">
                  ${escapeHtml(site.name || "Untitled Website")}
                </div>

                <div class="website-package">
                  ${escapeHtml(packageName)}
                </div>
              </div>

              <div class="live-badge">
                <span class="live-dot"></span>
                LIVE
              </div>

            </div>

            <div
              class="preview-viewport"
              data-index="${index}"
            >

              <div class="loader">
                <div class="loader-ring"></div>
              </div>

              <div
                class="preview-camera"
                id="camera-${index}"
              >

                <iframe
                  class="preview-frame"
                  src="${safeUrl(site.url)}"
                  title="${escapeHtml(site.name || "Live Website")}"
                  loading="${index === 0 ? "eager" : "lazy"}"
                  referrerpolicy="strict-origin-when-cross-origin"
                  onload="websiteLoaded(${index})"
                  onerror="websiteFailed(${index})"
                ></iframe>

              </div>

              <div
                class="human-cursor"
                id="cursor-${index}"
              ></div>

              <div class="scroll-hint">
                LIVE BROWSING
              </div>

            </div>

            <div class="website-bottom">

              <div class="status-text" id="status-${index}">
                ● Auto browsing
              </div>

              <div class="website-actions">

                <button
                  class="mini-btn"
                  onclick="openLive('${escapeAttribute(site.url)}')"
                >
                  Live ↗
                </button>

                <button
                  class="mini-btn primary"
                  onclick="openPresentation(${index})"
                >
                  Explore
                </button>

              </div>

            </div>

          </article>
        `;
      }).join("");

      /*
        Give browser one paint cycle before starting movement.
      */
      requestAnimationFrame(() => {
        websites.forEach((site, index) => {
          startHumanBrowsing(index);
        });
      });
    }

    /* =========================================================
       HUMAN-LIKE BROWSING ENGINE
       
       This intentionally behaves more like a human than
       a constant CSS marquee.
    ========================================================= */

    const activeBrowsers = new Map();

    function startHumanBrowsing(index) {

      const camera = document.getElementById(`camera-${index}`);
      const cursor = document.getElementById(`cursor-${index}`);
      const viewport = document.querySelector(
        `.preview-viewport[data-index="${index}"]`
      );

      if (!camera || !cursor || !viewport) return;

      /*
        Small random delay means all cards don't start together.
      */

      const initialDelay =
        1200 +
        Math.floor(Math.random() * 3500);

      setTimeout(() => {

        const browser = {
          running: true,
          paused: false,
          direction: 1,
          position: 0,
          maxDistance: 1000,
          viewportHeight: viewport.clientHeight
        };

        activeBrowsers.set(index, browser);

        runHumanCycle(index);

      }, initialDelay);
    }

    function runHumanCycle(index) {

      const browser = activeBrowsers.get(index);

      if (!browser || !browser.running) return;

      const camera = document.getElementById(`camera-${index}`);
      const cursor = document.getElementById(`cursor-${index}`);
      const viewport = document.querySelector(
        `.preview-viewport[data-index="${index}"]`
      );

      if (!camera || !cursor || !viewport) return;

      /*
        The iframe is deliberately taller than the visible card.
        The camera moves over it.
      */

      const iframeHeight = 1800;
      const viewportHeight = viewport.clientHeight;

      browser.maxDistance =
        Math.max(250, iframeHeight - viewportHeight);

      /*
        Randomly choose a human-like scroll chunk.
      */

      const chunkOptions = [
        120,
        160,
        190,
        230,
        270,
        310,
        360
      ];

      const chunk =
        chunkOptions[
          Math.floor(Math.random() * chunkOptions.length)
        ];

      let nextPosition =
        browser.position +
        (chunk * browser.direction);

      /*
        Near bottom:
        stay there before returning.
      */

      if (
        browser.direction === 1 &&
        nextPosition >= browser.maxDistance
      ) {

        nextPosition = browser.maxDistance;

        browser.position = nextPosition;

        moveCamera(
          camera,
          nextPosition,
          randomScrollDuration()
        );

        moveFakeCursor(cursor, viewport, true);

        const bottomPause =
          1800 +
          Math.floor(Math.random() * 2500);

        setTimeout(() => {

          browser.direction = -1;

          runHumanCycle(index);

        }, bottomPause);

        return;
      }

      /*
        At top:
        pause before starting another visit.
      */

      if (
        browser.direction === -1 &&
        nextPosition <= 0
      ) {

        nextPosition = 0;

        browser.position = 0;

        moveCamera(
          camera,
          0,
          1300
        );

        moveFakeCursor(cursor, viewport, false);

        const topPause =
          1800 +
          Math.floor(Math.random() * 3000);

        setTimeout(() => {

          browser.direction = 1;

          runHumanCycle(index);

        }, topPause);

        return;
      }

      browser.position = nextPosition;

      /*
        Human scrolling uses different durations.
      */

      const duration =
        randomScrollDuration();

      moveCamera(
        camera,
        nextPosition,
        duration
      );

      /*
        Cursor movement happens at almost the same time.
      */

      moveFakeCursor(
        cursor,
        viewport,
        false
      );

      /*
        Sometimes human "reads" a section.
      */

      const shouldPause =
        Math.random() < 0.22;

      const pauseTime =
        shouldPause
          ? 1000 + Math.floor(Math.random() * 2300)
          : 80 + Math.floor(Math.random() * 250);

      setTimeout(() => {

        if (!browser.running) return;

        runHumanCycle(index);

      }, duration + pauseTime);
    }

    /* =========================================================
       CAMERA MOVEMENT
    ========================================================= */

    function moveCamera(camera, position, duration) {

      camera.style.transition =
        `transform ${duration}ms cubic-bezier(.22,.61,.36,1)`;

      camera.style.transform =
        `translate3d(0, -${position}px, 0)`;
    }

    function randomScrollDuration() {

      const values = [
        900,
        1100,
        1250,
        1450,
        1650,
        1900
      ];

      return values[
        Math.floor(Math.random() * values.length)
      ];
    }

    /* =========================================================
       FAKE HUMAN CURSOR
    ========================================================= */

    function moveFakeCursor(cursor, viewport, atBottom) {

      cursor.style.opacity = ".82";

      const width = viewport.clientWidth;
      const height = viewport.clientHeight;

      const positions = [
        {
          x: width * .22,
          y: height * .26
        },
        {
          x: width * .72,
          y: height * .30
        },
        {
          x: width * .48,
          y: height * .52
        },
        {
          x: width * .78,
          y: height * .68
        },
        {
          x: width * .25,
          y: height * .74
        }
      ];

      let position;

      if (atBottom) {

        position = {
          x: width * (.35 + Math.random() * .3),
          y: height * .5
        };

      } else {

        position =
          positions[
            Math.floor(Math.random() * positions.length)
          ];
      }

      cursor.style.left =
        `${Math.max(8, position.x)}px`;

      cursor.style.top =
        `${Math.max(8, position.y)}px`;
    }

    /* =========================================================
       PAUSE ON HOVER
       
       This gives a natural interaction:
       if client puts mouse over card, auto browsing pauses.
    ========================================================= */

    document.addEventListener("mouseover", event => {

      const card =
        event.target.closest(".website-card");

      if (!card) return;

      const viewport =
        card.querySelector(".preview-viewport");

      if (!viewport) return;

      const index =
        Number(viewport.dataset.index);

      const browser =
        activeBrowsers.get(index);

      if (browser) {
        browser.running = false;
      }

      const status =
        document.getElementById(`status-${index}`);

      if (status) {
        status.textContent =
          "● Paused on hover";
      }
    });

    document.addEventListener("mouseout", event => {

      const card =
        event.target.closest(".website-card");

      if (!card) return;

      if (card.contains(event.relatedTarget)) return;

      const viewport =
        card.querySelector(".preview-viewport");

      if (!viewport) return;

      const index =
        Number(viewport.dataset.index);

      const oldBrowser =
        activeBrowsers.get(index);

      if (oldBrowser) {
        oldBrowser.running = false;
      }

      /*
        Restart with a fresh cycle.
      */

      const browser = {
        running: true,
        paused: false,
        direction: 1,
        position: 0
      };

      activeBrowsers.set(index, browser);

      const camera =
        document.getElementById(`camera-${index}`);

      if (camera) {

        const currentTransform =
          getComputedStyle(camera).transform;

        /*
          Keep current position visually rather than jumping.
        */

        if (currentTransform !== "none") {
          // Browser continues from current camera position.
        }
      }

      setTimeout(() => {
        runHumanCycle(index);
      }, 700);

      const status =
        document.getElementById(`status-${index}`);

      if (status) {
        status.textContent =
          "● Auto browsing";
      }
    });

    /* =========================================================
       IFRAME STATUS
    ========================================================= */

    function websiteLoaded(index) {

      const viewport =
        document.querySelector(
          `.preview-viewport[data-index="${index}"]`
        );

      if (!viewport) return;

      const loader =
        viewport.querySelector(".loader");

      if (loader) {
        loader.style.display = "none";
      }
    }

    function websiteFailed(index) {

      const viewport =
        document.querySelector(
          `.preview-viewport[data-index="${index}"]`
        );

      if (!viewport) return;

      const loader =
        viewport.querySelector(".loader");

      if (loader) {
        loader.innerHTML = `
          <div style="
            text-align:center;
            padding:20px;
            color:#555;
            font-family:Inter,sans-serif;
            font-size:12px;
          ">
            <strong style="display:block;margin-bottom:7px;">
              Preview unavailable
            </strong>
            The live website may not allow iframe preview.
          </div>
        `;
      }
    }

    /* =========================================================
       EXPLORE / PRESENTATION
    ========================================================= */

    function openPresentation(index) {

      const site = websites[index];

      if (!site) return;

      currentWebsiteUrl = site.url;

      const modal =
        document.getElementById("presentationModal");

      const frame =
        document.getElementById("modalFrame");

      const title =
        document.getElementById("modalTitle");

      title.textContent =
        `${site.name} — Live Website`;

      frame.src = safeUrl(site.url);

      modal.classList.add("show");

      document.body.style.overflow = "hidden";
    }

    function closePresentation() {

      const modal =
        document.getElementById("presentationModal");

      const frame =
        document.getElementById("modalFrame");

      modal.classList.remove("show");

      frame.src = "about:blank";

      document.body.style.overflow = "";
    }

    function openCurrentWebsite() {

      if (!currentWebsiteUrl) return;

      window.open(
        safeUrl(currentWebsiteUrl),
        "_blank",
        "noopener,noreferrer"
      );
    }

    function openLive(url) {

      if (!url) return;

      window.open(
        safeUrl(url),
        "_blank",
        "noopener,noreferrer"
      );
    }

    /* =========================================================
       THEME
    ========================================================== */

    const THEME_KEY = "websiteDealsTheme";

    function loadTheme() {

      const saved =
        localStorage.getItem(THEME_KEY);

      if (saved === "light") {
        document.body.classList.add("light");
      }
    }

    function toggleTheme() {

      document.body.classList.toggle("light");

      localStorage.setItem(
        THEME_KEY,
        document.body.classList.contains("light")
          ? "light"
          : "dark"
      );
    }

    /* =========================================================
       MOBILE MENU
    ========================================================== */

    function toggleMobileMenu() {

      const nav =
        document.querySelector(".nav-links");

      if (!nav) return;

      const isOpen =
        nav.style.display === "flex";

      nav.style.display =
        isOpen ? "" : "flex";

      if (!isOpen) {

        nav.style.position = "absolute";
        nav.style.top = "64px";
        nav.style.left = "16px";
        nav.style.right = "16px";
        nav.style.padding = "10px";
        nav.style.flexDirection = "column";
        nav.style.alignItems = "stretch";
        nav.style.background = "var(--card)";
        nav.style.border = "1px solid var(--line)";
        nav.style.borderRadius = "16px";
      }
    }

    /* =========================================================
       HELPERS
    ========================================================== */

    function capitalize(value) {

      if (!value) return "";

      return value.charAt(0).toUpperCase() +
        value.slice(1);
    }

    function escapeHtml(value) {

      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function escapeAttribute(value) {

      return String(value ?? "")
        .replace(/\\/g, "\\\\")
        .replace(/'/g, "\\'");
    }

    function safeUrl(value) {

      try {

        const url =
          new URL(String(value));

        if (
          url.protocol === "https:" ||
          url.protocol === "http:"
        ) {
          return url.href;
        }

      } catch (error) {}

      return "about:blank";
    }

    /* =========================================================
       CLOSE MODAL ON BACKDROP
    ========================================================== */

    document
      .getElementById("presentationModal")
      .addEventListener("click", event => {

        if (
          event.target.id === "presentationModal"
        ) {
          closePresentation();
        }
      });

    /* ESC = CLOSE */

    document.addEventListener("keydown", event => {

      if (event.key === "Escape") {
        closePresentation();
      }
    });

    /* =========================================================
       ACTIVE NAV
    ========================================================== */

    const sections =
      document.querySelectorAll("main section[id]");

    const navItems =
      document.querySelectorAll(".nav-links a[href^='#']");

    const observer =
      new IntersectionObserver(
        entries => {

          entries.forEach(entry => {

            if (!entry.isIntersecting) return;

            navItems.forEach(link => {

              link.classList.remove("active");

              if (
                link.getAttribute("href") ===
                `#${entry.target.id}`
              ) {
                link.classList.add("active");
              }
            });

          });

        },
        {
          threshold: .25
        }
      );

    sections.forEach(section => {
      observer.observe(section);
    });

    /* =========================================================
       RESIZE
    ========================================================== */

    window.addEventListener("resize", () => {

      /*
        No horizontal movement.
        Cards remain fixed.
        Camera movement automatically adapts.
      */

    });

    /* =========================================================
       START
    ========================================================== */

    document.getElementById("year").textContent =
      new Date().getFullYear();

    loadTheme();
    loadWebsites();

  </script>

