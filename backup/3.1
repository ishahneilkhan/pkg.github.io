  <script>
    /* =========================================
       WEBSITE DATA
    ========================================== */

    const STORAGE_KEY = "websiteDealsWebsites";

    const defaultWebsites = [
      {
        id: "snk-it-institute",
        name: "SNK IT Institute",
        package: "business",
        packageLabel: "Business Package",
        url: "https://snkitinstitute.com",
        status: true,
        sort: 1
      },
      {
        id: "website-deals",
        name: "Website Deals",
        package: "premium",
        packageLabel: "Premium Package",
        url: "https://websitedeals.com",
        status: true,
        sort: 2
      }
    ];


    function getWebsites() {

      try {

        const saved =
          JSON.parse(
            localStorage.getItem(STORAGE_KEY)
          );

        if (
          Array.isArray(saved) &&
          saved.length
        ) {
          return saved;
        }

      } catch (error) {
        console.warn(
          "Could not read website data.",
          error
        );
      }

      return defaultWebsites;

    }


    /* =========================================
       WEBSITE CARD
    ========================================== */

    const websiteGrid =
      document.getElementById("websiteGrid");


    function escapeHTML(value) {

      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }


    function renderWebsites() {

      const websites =
        getWebsites()
          .filter(site => site.status !== false)
          .sort(
            (a, b) =>
              Number(a.sort || 999) -
              Number(b.sort || 999)
          );


      if (!websites.length) {

        websiteGrid.innerHTML = `
          <div class="info-card">
            <h3>No websites yet</h3>
            <p>
              Add real website links from the admin panel.
            </p>
          </div>
        `;

        return;
      }


      websiteGrid.innerHTML =
        websites.map((site, index) => {

          const siteId =
            escapeHTML(site.id || `site-${index}`);

          const siteName =
            escapeHTML(
              site.name || "Website"
            );

          const packageLabel =
            escapeHTML(
              site.packageLabel ||
              "Website Package"
            );

          const siteUrl =
            escapeHTML(
              site.url || "#"
            );


          return `
            <article
              class="website-card"
              data-site-id="${siteId}"
            >

              <div class="website-top">

                <div class="website-name">

                  <strong>
                    ${siteName}
                  </strong>

                  <span>
                    ${packageLabel}
                  </span>

                </div>

                <span class="live-badge">
                  Live
                </span>

              </div>


              <div class="preview-viewport">

                <div class="preview-camera">

                  <iframe
                    class="preview-frame"
                    src="${siteUrl}"
                    title="${siteName} live website preview"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                  ></iframe>

                </div>


                <div class="fake-cursor"></div>

                <div class="preview-shade"></div>

              </div>


              <div class="website-bottom">

                <div class="website-meta">

                  <span class="website-package">
                    ${packageLabel}
                  </span>

                  <span class="website-url">
                    ${siteUrl}
                  </span>

                </div>

                <a
                  href="./presentation/index.html?site=${encodeURIComponent(site.id || "")}"
                  class="explore-btn"
                >
                  Explore Live Website ↗
                </a>

              </div>

            </article>
          `;

        }).join("");


      initializeWebsiteCameras();

    }


    /* =========================================
       HUMAN-LIKE CAMERA
    ========================================== */

    function initializeWebsiteCameras() {

      const cards =
        document.querySelectorAll(".website-card");


      cards.forEach((card, index) => {

        const viewport =
          card.querySelector(".preview-viewport");

        const camera =
          card.querySelector(".preview-camera");

        const cursor =
          card.querySelector(".fake-cursor");

        const iframe =
          card.querySelector(".preview-frame");


        if (!viewport || !camera || !cursor) {
          return;
        }


        let timer = null;
        let stopped = false;
        let position = 0;


        const viewportHeight =
          viewport.clientHeight;

        const pageHeight = 1900;

        const maxPosition =
          Math.max(
            0,
            pageHeight - viewportHeight
          );


        function random(min, max) {

          return Math.floor(
            Math.random() *
            (max - min + 1)
          ) + min;

        }


        function moveCursor() {

          const x =
            random(
              18,
              Math.max(
                20,
                viewport.clientWidth - 35
              )
            );

          const y =
            random(
              35,
              Math.max(
                45,
                viewportHeight - 45
              )
            );

          cursor.style.left = `${x}px`;
          cursor.style.top = `${y}px`;

        }


        function applyPosition() {

          camera.style.transform =
            `translate3d(0, -${position}px, 0)`;

        }


        function scheduleNext() {

          clearTimeout(timer);


          if (stopped) {
            return;
          }


          /*
            Small natural reading pauses.
          */

          if (Math.random() < .24) {

            timer =
              setTimeout(
                scheduleNext,
                random(1200, 3000)
              );

            moveCursor();

            return;
          }


          if (position >= maxPosition) {

            timer =
              setTimeout(
                () => {

                  if (stopped) {
                    return;
                  }

                  position = 0;

                  camera.style.transition =
                    "transform 1800ms cubic-bezier(.22,.61,.36,1)";

                  applyPosition();
                  moveCursor();


                  timer =
                    setTimeout(
                      scheduleNext,
                      random(900, 1700)
                    );

                },
                random(1800, 4200)
              );

            return;
          }


          const chunk =
            random(95, 245);

          position =
            Math.min(
              maxPosition,
              position + chunk
            );


          const duration =
            random(1100, 2100);


          camera.style.transition =
            `transform ${duration}ms cubic-bezier(.22,.61,.36,1)`;


          /*
            Tiny horizontal cursor drift
            makes the preview feel more human.
          */

          moveCursor();

          applyPosition();


          timer =
            setTimeout(
              scheduleNext,
              duration + random(250, 900)
            );

        }


        function start() {

          stopped = false;

          clearTimeout(timer);

          /*
            Each card gets a slightly different
            starting delay.
          */

          timer =
            setTimeout(
              scheduleNext,
              random(
                1000 + index * 350,
                3000 + index * 600
              )
            );

        }


        function stop() {

          stopped = true;

          clearTimeout(timer);

        }


        /*
          Pause when client hovers the card.
          This lets them inspect the website.
        */

        card.addEventListener(
          "mouseenter",
          stop
        );


        card.addEventListener(
          "mouseleave",
          start
        );


        /*
          If iframe refuses framing, the card
          still remains usable through Explore.
        */

        if (iframe) {

          iframe.addEventListener(
            "load",
            () => {
              moveCursor();
            }
          );

        }


        start();

      });

    }


    /* =========================================
       MOBILE MENU
    ========================================== */

    const menuBtn =
      document.getElementById("menuBtn");

    const mobileMenu =
      document.getElementById("mobileMenu");


    menuBtn.addEventListener(
      "click",
      () => {

        mobileMenu.classList.toggle("open");

      }
    );


    mobileMenu
      .querySelectorAll("a")
      .forEach(link => {

        link.addEventListener(
          "click",
          () => {
            mobileMenu.classList.remove("open");
          }
        );

      });


    /* =========================================
       NETWORK STATUS
    ========================================== */

    const networkDot =
      document.getElementById("networkDot");

    const networkText =
      document.getElementById("networkText");


    function updateNetworkStatus() {

      const online =
        navigator.onLine;


      networkDot.classList.toggle(
        "offline",
        !online
      );


      networkText.textContent =
        online
          ? "Online"
          : "Offline";

    }


    window.addEventListener(
      "online",
      updateNetworkStatus
    );

    window.addEventListener(
      "offline",
      updateNetworkStatus
    );

    updateNetworkStatus();


    /* =========================================
       PWA INSTALL
    ========================================== */

    let deferredInstallPrompt = null;


    const installTopBtn =
      document.getElementById("installTopBtn");

    const installPanel =
      document.getElementById("installPanel");

    const installNowBtn =
      document.getElementById("installNowBtn");

    const installLaterBtn =
      document.getElementById("installLaterBtn");


    window.addEventListener(
      "beforeinstallprompt",
      (event) => {

        event.preventDefault();

        deferredInstallPrompt = event;

        installTopBtn.hidden = false;

        setTimeout(
          () => {
            installPanel.classList.add("show");
          },
          3500
        );

      }
    );


    async function installApp() {

      if (!deferredInstallPrompt) {
        return;
      }


      deferredInstallPrompt.prompt();


      try {

        await deferredInstallPrompt.userChoice;

      } catch (error) {

        console.warn(
          "Install prompt closed.",
          error
        );

      }


      deferredInstallPrompt = null;

      installTopBtn.hidden = true;

      installPanel.classList.remove("show");

    }


    installTopBtn.addEventListener(
      "click",
      installApp
    );


    installNowBtn.addEventListener(
      "click",
      installApp
    );


    installLaterBtn.addEventListener(
      "click",
      () => {
        installPanel.classList.remove("show");
      }
    );


    window.addEventListener(
      "appinstalled",
      () => {

        deferredInstallPrompt = null;

        installTopBtn.hidden = true;

        installPanel.classList.remove("show");

      }
    );


    /* =========================================
       SERVICE WORKER
    ========================================== */

    if (
      "serviceWorker" in navigator
    ) {

      window.addEventListener(
        "load",
        async () => {

          try {

            const registration =
              await navigator.serviceWorker.register(
                "./sw.js",
                {
                  scope: "./"
                }
              );


            console.log(
              "Website Deals PWA registered.",
              registration.scope
            );

          } catch (error) {

            console.warn(
              "PWA registration failed:",
              error
            );

          }

        }
      );

    }


    /* =========================================
       INITIAL RENDER
    ========================================== */

    renderWebsites();

  </script>

</body>
